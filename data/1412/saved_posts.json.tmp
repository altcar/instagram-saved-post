owner": "carson___lai", "likes": 84}, {"id": 17862240204516844, "text": "你也太看不起我们了？", "created_at": "2025-11-08T18:05:33", "owner": "chongwei_than", "likes": 0}, {"id": 18077968465900731, "text": "", "created_at": "2025-11-08T16:37:49", "owner": "chenjiqie", "likes": 0}, {"id": 18068454362365791, "text": "Que envidia del que se coma esos tetones", "created_at": "2025-11-08T12:43:36", "owner": "illustrator_2001", "likes": 0}, {"id": 18029057909549659, "text": "🤤🤤🤤", "created_at": "2025-11-08T09:44:37", "owner": "kentang167", "likes": 0}, {"id": 18125632015501909, "text": "😍😍😍😍", "created_at": "2025-11-08T08:02:51", "owner": "wndrfl_wrld88", "likes": 0}, {"id": 17911499007249437, "text": "", "created_at": "2025-11-08T07:57:37", "owner": "bagasrian_piether", "likes": 0}, {"id": 17883668421402794, "text": "🔥🔥🔥", "created_at": "2025-11-08T07:50:59", "owner": "djslicktw", "likes": 0}, {"id": 18063472250398280, "text": "", "created_at": "2025-11-08T07:48:11", "owner": "tedtat", "likes": 0}, {"id": 17923172496177847, "text": "她笑起來真好看 之前每次看到她的照片或影片都是擺臭臉 完全審美疲勞", "created_at": "2025-11-08T07:45:14", "owner": "peggylinpeichi", "likes": 0}, {"id": 18096672865772828, "text": "", "created_at": "2025-11-08T02:51:29", "owner": "tony_woohaha", "likes": 0}, {"id": 18112357006519450, "text": "", "created_at": "2025-11-08T02:43:28", "owner": "kelvinzzzbambi", "likes": 3}, {"id": 18060873956564223, "text": "Is this even real or ai?", "created_at": "2025-11-08T02:06:59", "owner": "edmaddictofficial", "likes": 0}, {"id": 17857680984550061, "text": "", "created_at": "2025-11-07T19:57:22", "owner": "akash_shaji579", "likes": 0}, {"id": 18123809320510045, "text": "她有一对很大的性格！", "created_at": "2025-11-07T17:32:18", "owner": "widvxjxjcn", "likes": 0}, {"id": 17971716557808926, "text": "nice", "created_at": "2025-11-07T16:28:28", "owner": "_statik", "likes": 0}, {"id": 18046686905415056, "text": "", "created_at": "2025-11-07T15:44:40", "owner": "johny_wilson27", "likes": 0}, {"id": 18081709726864538, "text": "世界上我只服這個雪梨！", "created_at": "2025-11-07T13:57:26", "owner": "5656neverdie", "likes": 0}, {"id": 18052883036655383, "text": "字幕是哪個打的  失職", "created_at": "2025-11-07T12:38:34", "owner": "ronnie.th.wu", "likes": 0}, {"id": 17953365765014338, "text": "我真的不確定她說什麼、但我都同意", "created_at": "2025-11-07T11:21:24", "owner": "hihibasara", "likes": 0}, {"id": 17922375891176329, "text": "❤️", "created_at": "2025-11-07T11:12:06", "owner": "edward.nfu", "likes": 0}, {"id": 18085211488979829, "text": "PRETTY", "created_at": "2025-11-07T10:14:02", "owner": "beefcake_t", "likes": 0}, {"id": 17860210704465654, "text": "字幕不放那邊的話沒人會看", "created_at": "2025-11-07T09:00:45", "owner": "ufoufo1207", "likes": 0}, {"id": 17978639711927860, "text": "剪輯獨享了畫面👎", "created_at": "2025-11-07T08:41:33", "owner": "s930____", "likes": 0}, {"id": 18490383898076895, "text": "", "created_at": "2025-11-07T07:01:21", "owner": "c.kev1n", "likes": 5}, {"id": 18067878557369082, "text": "不打廣告不業配 純粹報復社會", "created_at": "2025-11-07T06:37:03", "owner": "thunder_who", "likes": 0}, {"id": 18071786447028625, "text": "", "created_at": "2025-11-07T05:41:54", "owner": "stick0079", "likes": 0}, {"id": 18085614409795204, "text": "睇唔到牛仔褲", "created_at": "2025-11-07T05:41:16", "owner": "pvt_ryanhk", "likes": 0}, {"id": 17857894869548522, "text": "字幕擋到了", "created_at": "2025-11-07T05:38:19", "owner": "rayscs", "likes": 0}, {"id": 18084545288053093, "text": "上字幕的用點心好不", "created_at": "2025-11-07T05:30:02", "owner": "a46080704", "likes": 0}, {"id": 17982348296916625, "text": "字幕組拖下去斬了👀", "created_at": "2025-11-07T05:20:18", "owner": "chaowei25", "likes": 0}, {"id": 18098009176824352, "text": "", "created_at": "2025-11-07T05:19:23", "owner": "landl_forl", "likes": 0}, {"id": 18084988627772635, "text": "", "created_at": "2025-11-07T04:49:36", "owner": "weimingxiang", "likes": 41}], "location": null, "hashtags": ["gq娛樂", "sydneysweeney", "高校十八禁"]},
{"media_id": 3791023370285493883, "shortcode": "DSca6tpEi57", "permalink": "https://www.instagram.com/p/DSca6tpEi57/", "taken_at": "2025-12-19T11:53:58", "caption": "Big Ben 😀", "owner_username": "luvelyfeelings", "owner_id": "61783459876", "likes": -1, "is_video": true, "typename": "GraphVideo", "media": [{"type": "video", "path": "0007_DSca6tpEi57\\DSca6tpEi57_20251219_115358.mp4"}], "comments": [{"id": 18094548607906442, "text": "Why did u even yelled at her", "created_at": "2025-12-19T12:09:49", "owner": "wisdom_over_trust", "likes": 2004}, {"id": 18075216677031040, "text": "WHY IS IT THERE", "created_at": "2025-12-19T13:53:23", "owner": "soa.1.4", "likes": 483}, {"id": 18073572983591987, "text": "Mine is bigger", "created_at": "2025-12-19T16:32:49", "owner": "lxndr.io", "likes": 654}, {"id": 18065799932171098, "text": "Eiffel Tower", "created_at": "2025-12-19T21:21:25", "owner": "sparkle_girlygurl", "likes": 50}, {"id": 18438264388109447, "text": "Gonna test out these photo vibes in London👅👅👅", "created_at": "2025-12-19T19:01:39", "owner": "g7nrrg", "likes": 55}, {"id": 18094020691732219, "text": "@kumali_mallikarachchi", "created_at": "2025-12-19T21:31:38", "owner": "aa._.rya", "likes": 2}, {"id": 18016512380803546, "text": "😂😂", "created_at": "2025-12-19T16:40:29", "owner": "sara.ii0_", "likes": 2}, {"id": 18124443391524121, "text": "@houssem__chaabani 😂", "created_at": "2025-12-19T21:30:20", "owner": "eadfacdue", "likes": 0}, {"id": 17973523517967629, "text": "What @mruncurry can be caught doing (2peg down)💔", "created_at": "2025-12-19T20:49:14", "owner": "shruti.divase", "likes": 3}, {"id": 18012554177807910, "text": "saving this till my trip to london!😂", "created_at": "2025-12-19T12:04:34", "owner": "prollysleeping__", "likes": 73}, {"id": 17929088559175827, "text": "GIRL WTF?👁️👄👁️", "created_at": "2025-12-19T19:01:56", "owner": "gotplayedbyfourseven", "likes": 8}, {"id": 17911920027258816, "text": "Mine is Burj Khalifa", "created_at": "2025-12-19T21:07:3