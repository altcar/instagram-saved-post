amonet", "likes": 0}, {"id": 18062216381542894, "text": "72", "created_at": "2025-11-30T13:58:09", "owner": "namkrow_rovert", "likes": 0}, {"id": 18385668238198399, "text": "demonic as fuck. especially white jesus", "created_at": "2025-11-30T13:57:41", "owner": "_.c_", "likes": 0}, {"id": 18124336231516948, "text": "", "created_at": "2025-11-30T13:56:53", "owner": "_.shelly.3xe._", "likes": 130}, {"id": 18544503418055844, "text": "What is muhammad doing? 9", "created_at": "2025-11-30T13:56:43", "owner": "aryaaa_rb", "likes": 0}, {"id": 18083641594863128, "text": "😂😂😂", "created_at": "2025-11-30T13:56:34", "owner": "limoncito_1800", "likes": 0}, {"id": 17972429126812105, "text": "I mean she's not wrong 🤷🏾‍♀️🤭", "created_at": "2025-11-30T13:55:33", "owner": "tashimaaaaaaa", "likes": 0}, {"id": 18095463358846372, "text": "😂😂😂", "created_at": "2025-11-30T13:55:28", "owner": "thurstonlebruh", "likes": 0}, {"id": 18087754505488379, "text": "Bahahaha., lotf", "created_at": "2025-11-30T13:55:25", "owner": "callmejacobthen", "likes": 0}, {"id": 17969474933826406, "text": "😂😂😂😂😂😂", "created_at": "2025-11-30T13:55:00", "owner": "ciql1", "likes": 0}, {"id": 18113317612595564, "text": "😂", "created_at": "2025-11-30T13:54:29", "owner": "kln_lkn", "likes": 0}, {"id": 18072899285035437, "text": "thats not even jesus🌚🤣", "created_at": "2025-11-30T13:54:05", "owner": "raejon_rondo", "likes": 0}, {"id": 17858270403559473, "text": "😂", "created_at": "2025-11-30T13:53:06", "owner": "_slim1k", "likes": 0}, {"id": 17867189772498638, "text": "What does 6-7 means?", "created_at": "2025-11-30T13:52:59", "owner": "jalilovich_1206", "likes": 0}, {"id": 17985920552756267, "text": "Got a point", "created_at": "2025-11-30T13:52:15", "owner": "9im4r", "likes": 0}, {"id": 17886898137403692, "text": "😂😂😂😂😂😂", "created_at": "2025-11-30T13:52:04", "owner": "sywar_mejry", "likes": 0}, {"id": 18065087270439885, "text": "LoL 🤣", "created_at": "2025-11-30T13:51:48", "owner": "lady_by_gods_design", "likes"