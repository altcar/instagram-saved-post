ikes": 0}, {"id": 18047245241439527, "text": "😭🙏", "created_at": "2025-11-27T08:15:46", "owner": "jihee52268", "likes": 0}, {"id": 18098350528693287, "text": "pray for Hongkong😭🙏", "created_at": "2025-11-27T08:15:27", "owner": "tiffchauuu", "likes": 0}, {"id": 17851620147554652, "text": "How did all those buildings catch on fire?", "created_at": "2025-11-27T08:15:27", "owner": "barbara.coyne.12", "likes": 0}, {"id": 17986457147877673, "text": "🙏🙏🙏", "created_at": "2025-11-27T08:15:26", "owner": "sze_66", "likes": 0}, {"id": 18067452851619767, "text": "🙏🙏", "created_at": "2025-11-27T08:15:00", "owner": "lovelygirl620000", "likes": 0}, {"id": 18070463486608585, "text": "I do not understand how did the fire gone till upper higher floors?", "created_at": "2025-11-27T08:14:55", "owner": "holee_brew", "likes": 0}, {"id": 17874495837448695, "text": "What a tragedy for the people in my hometown city！\n\nIt’s all down to the control of the Hong Kong Communist Party🤬🤬🤬", "created_at": "2025-11-27T08:14:39", "owner": "viola_manning0205", "likes": 0}, {"id": 18412545016139220, "text": "😢🙏🇭🇰", "created_at": "2025-11-27T08:13:51", "owner": "meipple_", "likes": 0}, {"id": 18103968589680031, "text": "its devastating very sad 😢", "created_at": "2025-11-27T08:13:44", "owner": "khanfatima2001", "likes": 0}, {"id": 18096851137894945, "text": "How did all buildings catch fire?", "created_at": "2025-11-27T08:13:34", "owner": "glacialimpala", "likes": 0}, {"id": 18065191997415191, "text": "💔😭🙏", "created_at": "2025-11-27T08:13:25", "owner": "lilianlil", "likes": 0}, {"id": 18049263497675572, "text": "OMG🙏希望大家都平平安安", "created_at": "2025-11-27T08:13:19", "owner": "chenqi7172", "likes": 1}, {"id": 17928151467152113, "text": "😢💔", "created_at": "2025-11-27T08:13:02", "owner": "simpsonchan", "likes": 0}, {"id": 18164939716388415, "text": "Devastating", "created_at": "2025-11-27T08:12:53", "owner": "irenavdh", "likes": 0}, {"id": 17891473347244767, "text": "😢😢", "created_at": "2025-11-27T08:12:53", "owner": "abog.almitavega", "likes": 2}, {"id": 18064710029400683, "text": "This is crazy 💔 absolutely heart broken and speechless", "created_at": "2025-11-27T08:12:46", "owner": "kawaiitttt", "likes": 0}, {"id": 18083813495028036, "text": "삼가 고인의 명복을 빕니다.  RIP.", "created_at": "2025-11-27T08:12:22", "owner": "aaker_kim", "likes": 0}, {"id": 18167421904379226, "text": "💔😭😭", "created_at": "2025-11-27T08:12:17", "owner": "einna__e", "likes": 0}, {"id": 18096635407842779, "text": "🙏", "created_at": "2025-11-27T08:12:07", "owner": "adult.sized.kid", "likes": 0}, {"id": 17889038220388845, "text": "😭😭😭😭", "created_at": "2025-11-27T08:11:50", "owner": "strong12060202", "likes": 0}, {"id": 18112114450591172, "text": "😭😭😭😭😭😭💔 ALLAHUAKBAR 😭😭😭😭", "created_at": "2025-11-27T08:11:47", "owner": "titin_mariyana6681", "likes": 0}, {"id": 18064778099174570, "text": "💔💔💔", "created_at": "2025-11-27T08:11:34", "owner": "laiipyn_", "likes": 0}, {"id": 18046480136690413, "text": "Saddest night in HK", "created_at": "2025-11-27T08:11:32", "owner": "rammyrosa_", "likes": 0}, {"id": 18087600436792384, "text": "😭😭😭😭😭😭😭😭", "created_at": "2025-11-27T08:11:15", "owner": "mermaid_in_the_deepsea", "likes": 0}, {"id": 18086082743475567, "text": "逝者安息🙏🙏", "created_at": "2025-11-27T08:11:12", "owner": "qinyili56", "likes": 0}, {"id": 17948327100061829, "text": "😢😢", "created_at": "2025-11-27T08:11:00", "owner": "delicieux_mono", "likes": 0}, {"id": 18103533073670072, "text": "😭😭😭💔💔💔", "created_at": "2025-11-27T08:10:52", "owner": "tingting_0827", "likes": 0}, {"id": 18048879581405367, "text": "🙏🙏🙏", "created_at": "2025-11-27T08:10:39", "owner": "tingting_0827", "likes": 0}, {"id": 17922192891192993, "text": "🙏🙏🙏😢", "created_at": "2025-11-27T08:10:39", "owner": "zoe860531", "likes": 0}, {"id": 18041301311698093, "text": "So sad..😢🙏", "created_at": "2025-11-27T08:10:25", "owner": "ideal.property.bali", "likes": 0}, {"id": 18101126362684090, "text": "😢😢😢", "created_at": "2025-11-27T08:10:21", "owner": "eraybas80", "likes": 0}, {"id": 17995205060850492, "text": "Strašne 😮", "created_at": "2025-11-27T08:10:19", "owner": "patrikgerba", "likes": 0}, {"id": 18295454914285813, "text": "😢😢", "created_at": "2025-11-27T08:10:18", "owner": "neang_ruby.0", "likes": 0}, {"id": 17894256864225628, "text": "😢🙏", "created_at": "2025-11-27T08:10:09", "owner": "kentlai17", "likes": 0}, {"id": 18049878536679668, "text": "My thoughts are with all those who have lost a loved one, with all those who have passed away. May strength and courage help you through these difficult times.", "created_at": "2025-11-27T08:10:02", "owner": "transminase", "likes": 5402}, {"id": 18127222552502808, "text": "🙏", "created_at": "2025-11-27T08:09:48", "owner": "heathng_", "likes": 0}, {"id": 17849742309565439, "text": "😢", "created_at": "2025-11-27T08:09:37", "owner": "viola_hu62", "likes": 0}, {"id": 17876708883352193, "text": "🙏🙏😢", "created_at": "2025-11-27T08:09:36", "owner": "lumiareaa", "likes": 0}, {"id": 18068287613612341, "text": "😢😢", "created_at": "2025-11-27T08:09:32", "owner": "lilinor", "likes": 0}, {"id": 18134161732484374, "text": "🙏🙏🙏😭💔", "created_at": "2025-11-27T08:09:05", "owner": "kimrich_08", "likes": 9}, {"id": 18318130423217917, "text": "🙏🙏🙏😢", "created_at": "2025-11-27T08:09:01", "owner": "ma_ko.jp", "likes": 0}, {"id": 17949712659052783, "text": "ohmygod🥲", "created_at": "2025-11-27T08:08:55", "owner": "yipw.c", "likes": 0}, {"id": 17919895713218257, "text": "AI?!😭", "created_at": "2025-11-27T08:08:24", "owner": "pjungme", "likes": 0}, {"id": 18291610168278588, "text": "lord Jesus save them", "created_at": "2025-11-27T08:08:21", "owner": "paternafresno", "likes": 0}, {"id": 18059712167253450, "text": "🙏🙏🙏", "created_at": "2025-11-27T08:08:07", "owner": "taiyun25", "likes": 0}, {"id": 17934649002105627, "text": "😢😢😢", "created_at": "2025-11-27T08:07:56", "owner": "waycelee", "likes": 0}, {"id": 18109657882611295, "text": "Yüksek binaların hiçbir zaman güvenli olmadığını artık öğrenmeniz gerekiyor bu doğru olmayan bir şey ve tehlikeli bir şey yangınlara ölümlere sebebiyet olur", "created_at": "2025-11-27T08:07:45", "owner": "sirac295", "likes": 0}, {"id": 18089078365757120, "text": "🙏🙏🙏🙏🙏🙏", "created_at": "2025-11-27T08:07:45", "owner": "_meimei_108", "likes": 0}, {"id": 18159309355393152, "text": "This apartment already have tenant or just in construction?", "created_at": "2025-11-27T08:07:42", "owner": "dearjafni", "likes": 0}, {"id": 18026332463579805, "text": "Amitofo 🙏", "created_at": "2025-11-27T08:07:35", "owner": "kennytch4939", "likes": 0}, {"id": 18338946307239962, "text": "In Hong Kong, which has become China, this will happen often in the future", "created_at": "2025-11-27T08:07:31", "owner": "wufjeiw", "likes": 0}, {"id": 18152877871417336, "text": "😢", "created_at": "2025-11-27T08:07:20", "owner": "saimiaomiao", "likes": 0}, {"id": 18063329282449002, "text": "", "created_at": "2025-11-27T08:07:18", "owner": "pauluzdaniel", "likes": 0}, {"id": 17848969551573161, "text": "Crazy 😭😭", "created_at": "2025-11-27T08:07:06", "owner": "benaiah_fung", "likes": 0}, {"id": 18162193060398599, "text": "😢🙏💔", "created_at": "2025-11-27T08:06:54", "owner": "diego.munoz.b", "likes": 0}, {"id": 17868945363475217, "text": "😭😭😭😭😭 우짠댜", "created_at": "2025-11-27T08:06:49", "owner": "jeongyeonan1", "likes": 0}, {"id": 18080626349279456, "text": "😢", "created_at": "2025-11-27T08:06:42", "owner": "h.m.montre", "likes": 0}, {"id": 18104315362646730, "text": "😢", "created_at": "2025-11-27T08:06:34", "owner": "delawawab", "likes": 0}, {"id": 17891562360243939, "text": "So devastating 😢 having family live over there is scaring me. I pray that everyone gets found alive 🙏 I send out prayers for those who’ve lost their loved ones 🙏💔", "created_at": "2025-11-27T08:06:33", "owner": "cccorrrineppurvisss", "likes": 0}, {"id": 18095098099847763, "text": "Ya Alloh😢", "created_at": "2025-11-27T08:06:29", "owner": "valin_park", "likes": 0}, {"id": 18068287049096420, "text": "😢🙏💔", "created_at": "2025-11-27T08:05:53", "owner": "cinziaventura", "likes": 0}, {"id": 18068126795615362, "text": "😢", "created_at": "2025-11-27T08:05:53", "owner": "eanean719", "likes": 0}, {"id": 18516746344066067, "text": "感谢伟大党领导 每次死亡人数 都控制在39人以内", "created_at": "2025-11-27T08:05:35", "owner": "edge781016", "likes": 0}, {"id": 17954559258017240, "text": "Pray for HK 🙏", "created_at": "2025-11-27T08:05:35", "owner": "bichnhung.hoang", "likes": 0}, {"id": 18078551030165591, "text": "I feel very sad🙏", "created_at": "2025-11-27T08:05:09", "owner": "beier82571", "likes": 0}, {"id": 18099279460753699, "text": "How could the fire caught ok each building.  I saw some of it are very distant", "created_at": "2025-11-27T08:04:49", "owner": "mamomei", "likes": 9}, {"id": 18549843676063717, "text": "🙏🕊🙏", "created_at": "2025-11-27T08:04:30", "owner": "handts13", "likes": 0}, {"id": 18070356065593233, "text": "🙏🙏🙏🙏🙏🙏🙏", "created_at": "2025-11-27T08:04:21", "owner": "me.candy.01", "likes": 0}, {"id": 18090632284743349, "text": "RIP 🙏🙏🙏🙏", "created_at": "2025-11-27T08:04:18", "owner": "cheokkeikuan", "likes": 0}, {"id": 18048995417666077, "text": "哭了", "created_at": "2025-11-27T08:04:06", "owner": "aanancy4569", "likes": 0}, {"id": 17897207268345788, "text": "💔💔💔Sending prayer", "created_at": "2025-11-27T08:04:06", "owner": "_ivyszy_", "likes": 0}, {"id": 18303118870251751, "text": "My heart goes out to the people of Tai Po", "created_at": "2025-11-27T08:04:05", "owner": "ohroxo", "likes": 0}, {"id": 18029172461750795, "text": "🙏", "created_at": "2025-11-27T08:04:00", "owner": "jun784705", "likes": 0}, {"id": 18066192539136602, "text": "@oz710 @dbdb405", "created_at": "2025-11-27T08:03:56", "owner": "popoeywong", "likes": 0}, {"id": 18088869412756655, "text": "The bambooes stand still? .", "created_at": "2025-11-27T08:03:43", "owner": "novitannia27", "likes": 0}, {"id": 18086916892980192, "text": "😢🙏", "created_at": "2025-11-27T08:03:35", "owner": "vonlivon", "likes": 0}, {"id": 17940333423024214, "text": "🙏🙏🙏🙏", "created_at": "2025-11-27T08:03:22", "owner": "narsha_ey", "likes": 1}, {"id": 18033932705727341, "text": "🙏🙏🙏", "created_at": "2025-11-27T08:03:16", "owner": "riva726", "likes": 0}, {"id": 17942727249085118, "text": "🙏💔💔", "created_at": "2025-11-27T08:02:54", "owner": "eurojackys", "likes": 0}, {"id": 18084200099063294, "text": "🙏😭", "created_at": "2025-11-27T08:02:51", "owner": "janelawcy", "likes": 0}, {"id": 18135324628482650, "text": "And despite what all the American news media is saying - the bamboo scaffolding is still there and it has not burnt. The bamboo wasn't the problem, it was the non-standard plastic netting which burnt", "created_at": "2025-11-27T08:02:35", "owner": "whitelight.tv", "likes": 0}, {"id": 18069711623377263, "text": "🙏🙏🙏🙏", "created_at": "2025-11-27T08:02:10", "owner": "chaoyang_5t5", "likes": 5}, {"id": 18069278717086364, "text": "😢", "created_at": "2025-11-27T08:02:06", "owner": "diahoktavia", "likes": 0}, {"id": 18030555509685457, "text": "💔", "created_at": "2025-11-27T08:01:53", "owner": "moki20241111", "likes": 0}, {"id": 17880042681425623, "text": "Pray for the terrible situation😭😭", "created_at": "2025-11-27T08:01:52", "owner": "sasasastototot", "likes": 0}, {"id": 17978931146929113, "text": "May justice prevail 🙏 RIP to those who lost their lives 😢", "created_at": "2025-11-27T08:01:49", "owner": "prettylilcuddles", "likes": 0}, {"id": 18330196069208661, "text": "😮", "created_at": "2025-11-27T08:01:43", "owner": "abah.ipinn", "likes": 0}, {"id": 17851140003595735, "text": "💔😭", "created_at": "2025-11-27T08:01:43", "owner": "suryati_atie", "likes": 0}, {"id": 18103723336591698, "text": "💔🙏🙏😢", "created_at": "2025-11-27T08:01:31", "owner": "elmerfudge12", "likes": 0}, {"id": 18099482590758564, "text": "🙏🙏🙏", "created_at": "2025-11-27T08:01:18", "owner": "monllyleong", "likes": 0}, {"id": 17941754933961695, "text": "Sorry for all the victims, but I guess new building is coming 🙏", "created_at": "2025-11-27T08:01:12", "owner": "hendraoktaviano", "likes": 0}, {"id": 18063644447430011, "text": "🙏", "created_at": "2025-11-27T08:00:53", "owner": "dykang15", "likes": 0}, {"id": 18074791508251068, "text": "😭😭😭😭", "created_at": "2025-11-27T08:00:42", "owner": "theresia.xiang", "likes": 0}, {"id": 17869567350405586, "text": "😭😭😭", "created_at": "2025-11-27T08:00:39", "owner": "aqmalyati", "likes": 0}, {"id": 17947514423938205, "text": "Devastating", "created_at": "2025-11-27T08:00:27", "owner": "kahing619", "likes": 0}, {"id": 18132801310484182, "text": "fyi, the area is restricted for drone from nov 27 8am to nov 30 8am, just in case you didn’t catch the news", "created_at": "2025-11-27T08:00:14", "owner": "joetagram", "likes": 0}, {"id": 18048634901412776, "text": "I am devastated for Tai Po.", "created_at": "2025-11-27T07:59:45", "owner": "mavismoog", "likes": 0}, {"id": 17948090085062636, "text": "😢", "created_at": "2025-11-27T07:59:23", "owner": "kming_chan", "likes": 0}, {"id": 18102365860679512, "text": "🙏🙏🙏", "created_at": "2025-11-27T07:59:12", "owner": "gengarthegoat", "likes": 0}, {"id": 18411225937143309, "text": "😢😢😭", "created_at": "2025-11-27T07:59:11", "owner": "capri.gurl", "likes": 0}, {"id": 18183319774354967, "text": "😢😢😢", "created_at": "2025-11-27T07:59:05", "owner": "zhuc_99", "likes": 0}, {"id": 18190006570338460, "text": "😢😢😭", "created_at": "2025-11-27T07:59:01", "owner": "natalie_9601_chl", "likes": 0}, {"id": 18061805492199959, "text": "😢😢😢😢", "created_at": "2025-11-27T07:59:00", "owner": "rindukayyla", "likes": 0}, {"id": 17865556665437631, "text": "😢💔", "created_at": "2025-11-27T07:58:24", "owner": "larisasobchuk", "likes": 0}, {"id": 18114368830564573, "text": "💔", "created_at": "2025-11-27T07:58:08", "owner": "__.sehar.__", "likes": 0}, {"id": 18194674360331378, "text": "😢😢😢", "created_at": "2025-11-27T07:57:56", "owner": "lee3_three333", "likes": 0}, {"id": 17852043756592419, "text": "傷心💔，痛", "created_at": "2025-11-27T07:57:55", "owner": "walterwong817", "likes": 0}, {"id": 18330337186241603, "text": "This had to be intentional 💔", "created_at": "2025-11-27T07:57:45", "owner": "sprinkles_oo_", "likes": 0}, {"id": 17843759319621701, "text": "😢😢😢只能保佑那些伤者平安无事", "created_at": "2025-11-27T07:57:31", "owner": "lqy_041010", "likes": 9}, {"id": 18061134176219244, "text": "💔😭", "created_at": "2025-11-27T07:57:30", "owner": "kitin_harianti", "likes": 0}, {"id": 18095221120873924, "text": "Is it renovated and occupied building??!", "created_at": "2025-11-27T07:57:10", "owner": "michaeljanuar", "likes": 0}, {"id": 18062799368634897, "text": "🙏🙏🙏", "created_at": "2025-11-27T07:56:47", "owner": "zoe_chan1219", "likes": 0}, {"id": 18063219995551802, "text": "Heartbreaking 😭💔💔💔", "created_at": "2025-11-27T07:56:27", "owner": "theateeb_", "likes": 0}, {"id": 17956201551030194, "text": "😢🙏 what a tragedy sending prayers", "created_at": "2025-11-27T07:56:25", "owner": "lynnfrugtniet", "likes": 0}, {"id": 17940115160963714, "text": "💔🙏", "created_at": "2025-11-27T07:56:25", "owner": "popyu4realstate", "likes": 0}, {"id": 18100331014762903, "text": "💔😭💔😭", "created_at": "2025-11-27T07:56:15", "owner": "jultjoe", "likes": 0}, {"id": 17901481047304107, "text": "🙏", "created_at": "2025-11-27T07:56:13", "owner": "kennethoho", "likes": 0}, {"id": 18086461769292979, "text": "😂😂😂😂😂😂😂", "created_at": "2025-11-27T07:56:08", "owner": "loctar8", "likes": 0}, {"id": 17916260835216166, "text": "💔", "created_at": "2025-11-27T07:55:45", "owner": "alenvarghese", "likes": 0}, {"id": 18095878846876920, "text": "😭😭😭", "created_at": "2025-11-27T07:55:39", "owner": "miragetea", "likes": 0}, {"id": 18103608358732917, "text": "哇勒～香港唉🙏🙏", "created_at": "2025-11-27T07:55:38", "owner": "man601103", "likes": 0}, {"id": 18086722150811048, "text": "🙏🙏", "created_at": "2025-11-27T07:55:31", "owner": "sonia_lu1468", "likes": 0}, {"id": 18115060984573344, "text": "😭😭😭😭😭", "created_at": "2025-11-27T07:55:28", "owner": "minji_0919", "likes": 0}, {"id": 17929824387015799, "text": "😢 wait do people live there or those still under construction?", "created_at": "2025-11-27T07:55:18", "owner": "tmothi", "likes": 0}, {"id": 17902795035299615, "text": "😭💔💔🙏🙏", "created_at": "2025-11-27T07:55:08", "owner": "rena.lung", "likes": 2}, {"id": 18077226376957001, "text": "Katanya cina dah punya drone yg bisa bawa selang pemadam 🥺", "created_at": "2025-11-27T07:54:46", "owner": "kroofthendry", "likes": 0}, {"id": 18099208705801468, "text": "😢😢😢", "created_at": "2025-11-27T07:54:29", "owner": "erfansafarpoor1", "likes": 0}, {"id": 18061994297201802, "text": "🙏", "created_at": "2025-11-27T07:54:05", "owner": "lamlo_ted", "likes": 0}, {"id": 18083780672511822, "text": "Pray for hk", "created_at": "2025-11-27T07:54:03", "owner": "zanuary11", "likes": 0}, {"id": 18064549829157522, "text": "how separated buildings got in fire at the same time?", "created_at": "2025-11-27T07:54:03", "owner": "vania.tamara", "likes": 0}, {"id": 18079234096926115, "text": "I take it the water sprinkler system didn't work", "created_at": "2025-11-27T07:53:27", "owner": "darenalexander96", "likes": 0}, {"id": 18089210375295762, "text": "Lagune😭 seng bener cok @cahyadi.fitra", "created_at": "2025-11-27T07:53:11", "owner": "mochizukisvn", "likes": 0}, {"id": 17966923166837853, "text": "Kok bisa merembet ke gedung sebelahnya ya? 😢 RIP 🙏", "created_at": "2025-11-27T07:53:09", "owner": "hansinglauw", "likes": 0}, {"id": 18248406934292084, "text": "😢😢😢💔", "created_at": "2025-11-27T07:52:57", "owner": "jeeun_sung", "likes": 1}, {"id": 17948024963932606, "text": "😢", "created_at": "2025-11-27T07:52:40", "owner": "zireht_", "likes": 0}, {"id": 18040634075505445, "text": "😢😢", "created_at": "2025-11-27T07:52:29", "owner": "wu_elly", "likes": 0}, {"id": 17934254352105021, "text": "Please Pray for them 🙏", "created_at": "2025-11-27T07:52:24", "owner": "yvonne.chung.906", "likes": 0}, {"id": 17847190755610798, "text": "😭😭😭", "created_at": "2025