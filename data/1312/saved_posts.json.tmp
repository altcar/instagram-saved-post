51796764482, "text": "😂😂😂", "created_at": "2025-12-02T01:14:45", "owner": "msbrownmsbrown", "likes": 1}, {"id": 18084372938103487, "text": "", "created_at": "2025-12-02T01:11:30", "owner": "anonimo_lanca", "likes": 0}, {"id": 18087666148961774, "text": "😂😂😂😂", "created_at": "2025-12-02T01:11:07", "owner": "piiink_xoxo", "likes": 1}, {"id": 18084417923020851, "text": "", "created_at": "2025-12-02T01:04:09", "owner": "evanricardoperez", "likes": 0}, {"id": 18091215119504855, "text": "😂😂😂😂", "created_at": "2025-12-02T00:59:15", "owner": "roxanne._______", "likes": 1}, {"id": 18110368909614403, "text": "😂😂", "created_at": "2025-12-02T00:59:05", "owner": "_spam.account.02_", "likes": 1}, {"id": 18075237200520074, "text": "Bringing Jesus into that demonic saying is crazy.  Yall have to educate yourselves on things before you say it", "created_at": "2025-12-02T00:57:25", "owner": "ju_lee_nah20", "likes": 0}, {"id": 18065978993140330, "text": "", "created_at": "2025-12-02T00:57:12", "owner": "idiot_named_dyl", "likes": 0}, {"id": 18047795660441224, "text": "If the kid knows 6 7, the pacifier should be long gone 👀 😂", "created_at": "2025-12-02T00:53:56", "owner": "jmsports", "likes": 1}, {"id": 17864299647533079, "text": "im dead!", "created_at": "2025-12-02T00:53:02", "owner": "my_bundlesof_joy2.0", "likes": 0}, {"id": 18124705720515091, "text": "😂😂😂😂😂😂😂", "created_at": "2025-12-02T00:50:40", "owner": "tee.wudz", "likes": 1}, {"id": 18096649144678116, "text": "@qudwn8989  oh my...😭😭", "created_at": "2025-12-02T00:50:38", "owner": "myc2o2", "likes": 0}, {"id": 18536846254031179, "text": "⁶🙅‍♂️⁷", "created_at": "2025-12-02T00:49:17", "owner": "dazza_brunton", "likes": 0}, {"id": 17843534769628626, "text": "Charlie Kirk reboot cards", "created_at": "2025-12-02T00:49:10", "owner": "creslewis40", "likes": 0}, {"id": 18101690536606402, "text": "Now it makes sense why my son always says “6-7 in heaven” 😩", "created_at": "2025-12-02T00:48:53", "owner": "thatmocha", "likes": 2}, {"id": 18008188790815108, "text": "", "created_at": "2025-12-02T00:48:00", "owner": "zeynel35_", "likes": 0}, {"id": 18090396173307057, "text": "Noooooo 😂", "created_at": "2025-12-02T00:44:54", "owner": "sharayah.md", "likes": 2}, {"id": 18091535680931737, "text": "@lindsey91288", "created_at": "2025-12-02T00:43:25", "owner": "allee0808", "likes": 0}, {"id": 17932955585998422, "text": "🤣🤣🤣🤣🤣", "created_at": "2025-12-02T00:42:57", "owner": "nubian_floetry", "likes": 0}, {"id": 18084224704841776, "text": "Funny!!!", "created_at": "2025-12-02T00:42:07", "owner": "nicoleascannell", "likes": 1}, {"id": 18086846449962485, "text": "Ok we are so cooked", "created_at": "2025-12-02T00:41:47", "owner": "nascar_guymx_tvg", "likes": 1}, {"id": 18078317063271945, "text": "@brookewhite505", "created_at": "2025-12-02T00:40:48", "owner": "jason.scrivener", "likes": 0}, {"id": 18098629825836165, "text": "For my Catholics out there. Is that what we’re writing on our bodies at the start of mass? Just a bunch of 6’s & 7’s 😂", "created_at": "2025-12-02T00:39:13", "owner": "1handsomehansen", "likes": 2}, {"id": 17927734005158730, "text": "6 7 forever", "created_at": "2025-12-02T00:38:29", "owner": "rosie_fairy_puppy", "likes": 0}, {"id": 18081128072152659, "text": "you know thats demonic right?", "created_at": "2025-12-02T00:38:22", "owner": "jenangl3", "likes": 0}, {"id": 18048335081672992, "text": "Nahhh😂😂😂", "created_at": "2025-12-02T00:36:45", "owner": "_nieceyyyyyy", "likes": 1}, {"id": 18093547210918900, "text": "", "created_at": "2025-12-02T00:35:11", "owner": "maxperz000", "likes": 0}, {"id": 17914941288092692, "text": "No way u name her after kirk", "created_at": "2025-12-02T00:30:51", "owner": "angelewer", "likes": 0}, {"id": 18206275579314422, "text": "🤣🤣🤣", "created_at": "2025-12-02T00:29:58", "owner": "mariela__crawford", "likes": 1}, {"id": 17956559310003069, "text": "8-9", "created_at": "2025-12-02T00:29:05", "owner": "sir_casmnes", "likes": 1}, {"id": 18109418551616021, "text": "God created the heavens, earth, and all living things in six days before resting on the seventh. 67!", "created_at": "2025-12-02T00:29:04", "owner": "coleperske_731", "likes": 3}, {"id": 17976218249954728, "text": "😭", "created_at": "2025-12-02T00:27:09", "owner": "nuhhhhahhhh", "likes": 0}, {"id": 18051990374367540, "text": "😂😂😂", "created_at": "2025-12-02T00:26:43", "owner": "schuliving", "likes": 1}, {"id": 18056787800647742, "text": "Geração perdida da porra", "created_at": "2025-12-02T00:25:46", "owner": "jsevcn55", "likes": 0}, {"id": 17904487968153200, "text": "😂😂", "created_at": "2025-12-02T00:23:10", "owner": "alba_rego", "likes": 1}, {"id": 17985323201866529, "text": "🤣", "created_at": "2025-12-02T00:22:12", "owner": "michelevents", "likes": 1}, {"id": 17889286449386114, "text": "Of course. He did it first.", "created_at": "2025-12-02T00:21:26", "owner": "j.iniguez", "likes": 2}, {"id": 17916393591213008, "text": "🤣🤣", "created_at": "2025-12-02T00:21:13", "owner": "chelseadawna", "likes": 1}, {"id": 18090565192941724, "text": "", "created_at": "2025-12-02T00:18:10", "owner": "the_hater_himself", "likes": 0}, {"id": 17965975203003708, "text": "", "created_at": "2025-12-02T00:18:10", "owner": "elkhalafomar", "likes": 1}, {"id": 17907649227270928, "text": "What is 6. 7", "created_at": "2025-12-02T00:18:10", "owner": "f.m.q._", "likes": 0}, {"id": 18435114964110347, "text": "@saucyunicorn", "created_at": "2025-12-02T00:17:37", "owner": "danieldiasgranados", "likes": 0}, {"id": 18542281417034169, "text": "Shut up that not funny", "created_at": "2025-12-02T00:16:03", "owner": "mrbread227", "likes": 0}, {"id": 17937089378986054, "text": "@samixx.xz @zachr.ee 😭😭", "created_at": "2025-12-02T00:14:01", "owner": "injelmwehehehe", "likes": 0}, {"id": 18034863893722463, "text": "Jesus Sends the Apostles Mark 6:7... Jesus did knew the Futufe", "created_at": "2025-12-02T00:12:53", "owner": "simugott", "likes": 1}, {"id": 18546743365020246, "text": "This is actually perfect.", "created_at": "2025-12-02T00:11:13", "owner": "patrickmfloyd", "likes": 1}, {"id": 18031473518537037, "text": "SHES NOT WRONG", "created_at": "2025-12-02T00:06:35", "owner": "coffincuddlz", "likes": 53}, {"id": 18048902405695059, "text": "She got cursed before she was born.", "created_at": "2025-12-02T00:06:10", "owner": "ultramarathonkid", "likes": 0}, {"id": 18095067979876355, "text": "6 x 7 is 42 and in 42 years from now it will be 2067", "created_at": "2025-12-02T00:03:59", "owner": "tannerhayden88", "likes": 0}, {"id": 17987966729748028, "text": "😂😂😂", "created_at": "2025-12-02T00:03:57", "owner": "shallownadi", "likes": 1}, {"id": 18189113401339320, "text": "😂😂", "created_at": "2025-12-01T23:54:56", "owner": "arelys_312", "likes": 1}, {"id": 18062987615449806, "text": "White as jesus", "created_at": "2025-12-01T23:54:27", "owner": "bc_cookie", "likes": 0}, {"id": 17877599595440998, "text": "So that's why the Romans crucified him. Jesus was annoying to the Empire.", "created_at": "2025-12-01T23:48:52", "owner": "paulrqps", "likes": 0}, {"id": 18544488919006034, "text": "She's not wrong though lol", "created_at": "2025-12-01T23:48:44", "owner": "roberleine_designs", "likes": 3}, {"id": 18100692595685626, "text": "😂", "created_at": "2025-12-01T23:47:23", "owner": "nyc._st1", "likes": 1}, {"id": 18051386927375074, "text": "💀", "created_at": "2025-12-01T23:44:23", "owner": "dark_side891", "likes": 1}, {"id": 18320011486222721, "text": "😂😂😂😂😂😂😂😂😂", "created_at": "2025-12-01T23:43:50", "owner": "parisshanta_", "likes": 1}, {"id": 18192994693330996, "text": "😂😂😂😂😂", "created_at": "2025-12-01T23:43:09", "owner": "mohvvmed__334", "likes": 1}, {"id": 18076725017264388, "text": "Six days to create the world seventh day to rest", "created_at": "2025-12-01T23:41:24", "owner": "taylorsusan8", "likes": 1}, {"id": 18076886186187390, "text": "Omg", "created_at": "2025-12-01T23:40:03", "owner": "chonachungs", "likes": 2}, {"id": 18395752579120845, "text": "💀💀💀💀💀💀💀🤣", "