09-07T03:57:17", "owner": "444.isaac_", "likes": 2983}, {"id": 18106552240570936, "text": "Why did I believe her for a sec…", "created_at": "2025-09-15T23:15:11", "owner": "streetskaterdallen", "likes": 280}, {"id": 18072788279583378, "text": "", "created_at": "2025-11-29T20:21:47", "owner": "danny_da_kk5", "likes": 1}, {"id": 17932218713973856, "text": "", "created_at": "2025-09-15T04:24:22", "owner": "graysunzz", "likes": 431}, {"id": 18054465143206690, "text": "", "created_at": "2025-09-15T03:10:32", "owner": "kemosaf", "likes": 100}, {"id": 18051911453633120, "text": "She got him", "created_at": "2025-09-08T01:28:07", "owner": "graysonwood123", "likes": 226}, {"id": 17967285692994906, "text": "Go vegan.", "created_at": "2025-11-30T08:44:09", "owner": "veganmatias", "likes": 1}, {"id": 18129938422498364, "text": "I think he acc believed it for a sec 😂", "created_at": "2025-11-27T15:59:36", "owner": "zak_nazir", "likes": 2}, {"id": 18070340582171785, "text": "", "created_at": "2025-09-12T12:12:59", "owner": "marvix.vx", "likes": 526}, {"id": 17975975855781887, "text": "BRO IS NOT GOING BACK HOME 😭🥀💔", "created_at": "2025-09-11T22:21:03", "owner": "matheny_jake", "likes": 150}, {"id": 18114734305514298, "text": "", "created_at": "2025-12-09T03:58:19", "owner": "jakup284", "likes": 1}, {"id": 18292950130253771, "text": "Bro fell fa da hezi", "created_at": "2025-09-09T02:26:12", "owner": "trxp._3tiljumpin", "likes": 113}, {"id": 17876790720445997, "text": "", "created_at": "2025-12-12T05:44:21", "owner": "grav11", "likes": 1}, {"id": 18112703176561936, "text": "The most nonchalant way to make a joke", "created_at": "2025-10-20T07:18:51", "owner": "musa_ko_dulo", "likes": 4}, {"id": 18063287891204469, "text": "", "created_at": "2025-12-13T11:08:46", "owner": "ibrahimh28", "likes": 1}, {"id": 18013194248632897, "text": "She said no w a straight face 😂", "created_at": "2025-11-07T19:18:21", "owner": "m0m0amd", "likes": 5}, {"id": 18540828814027058, "text": "She wants him i just can't prove it yet", "created_at": "2025-10-14T04:22:49", "owner": "praise.jstnn", "likes": 46}, {"id": 18104186440659075, "text": "I read a statistic a couple years ago that said roughly 20% of adults in America genuinely believe brown cows make chocolate milk", "created_at": "2025-11-27T14:23:16", "owner": "redisgoo11", "likes": 2}, {"id": 18030757904709207, "text": "she just babied him 🤣😭‼️", "created_at": "2025-09-27T11:30:36", "owner": "d3v06450", "likes": 58}, {"id": 18189044056327549, "text": "The way she said“no-“had me done 😂😂😂", "created_at": "2025-10-24T23:40:31", "owner": "amirromain9", "likes": 2}, {"id": 18367666699081084, "text": "I'm a KNIGHT", "created_at": "2025-11-19T11:32:19", "owner": "8.18.22.7", "likes": 1}, {"id": 18324078532212325, "text": "", "created_at": "2025-11-12T20:46:26", "owner": "7.m9711", "likes": 17}, {"id": 18045598349691917, "text": "Is it just me but do they low-key have chemistry?", "created_at": "2025-10-25T21:23:25", "owner": "lowmirage_", "likes": 2}, {"id": 18091721128808835, "text": "@scarredheart432", "created_at": "2025-09-26T04:14:38", "owner": "modifications_10", "likes": 2}, {"id": 18084151709081997, "text": "That no at the end sounded so disappointed in todays people", "created_at": "2025-11-08T22:36:57", "owner": "b_juanxrk", "likes": 1}, {"id": 18244995136293695, "text": "@kryxsm_ tanawa bla ne hu lagtok HAHAHAHA", "created_at": "2025-11-10T02:00:13", "owner": "ranranako", "likes": 1}, {"id": 18114116479490110, "text": "No...😐😒", "created_at": "2025-10-19T09:52:18", "owner": "aleksandral.ss", "likes": 1}, {"id": 18103411114648859, "text": "Tell me you are from America without telling me you are from America😂", "created_at": "2025-11-08T10:24:47", "owner": "amandeep.singhh", "likes": 1}, {"id": 18105642544625299, "text": "", "created_at": "2025-11-05T09:42:27", "owner": "thecatisdead54d", "likes": 1}, {"id": 18396597985122713, "text": "", "created_at": "2025-11-05T15:28:04", "owner": "malick.khaled.5", "l