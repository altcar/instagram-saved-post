o333", "likes": 0}, {"id": 18066606230134915, "text": "😂😂😂😂", "created_at": "2025-12-04T12:47:26", "owner": "rinurebecca_abraham", "likes": 0}, {"id": 17845604475607205, "text": "💀", "created_at": "2025-12-04T12:47:11", "owner": "d3mi_peachy", "likes": 0}, {"id": 18116659036561206, "text": "😂😂😂😂😂", "created_at": "2025-12-04T12:44:59", "owner": "figgo74", "likes": 0}, {"id": 17866389798508056, "text": "@dn_x.tb", "created_at": "2025-12-04T12:43:48", "owner": "aquiles_moura_", "likes": 0}, {"id": 17868249276490742, "text": "& on the 7th day he rested 🤣😭", "created_at": "2025-12-04T12:41:55", "owner": "dayzee_lilo", "likes": 1}, {"id": 18056245052647986, "text": "@siiru_liini", "created_at": "2025-12-04T12:39:07", "owner": "ellanikkonen", "likes": 0}, {"id": 18441363859101576, "text": "", "created_at": "2025-12-04T12:38:24", "owner": "_j0hhnnn", "likes": 0}, {"id": 18062156564632167, "text": "", "created_at": "2025-12-04T12:35:50", "owner": "oscarcheahx", "likes": 0}, {"id": 18498114313077201, "text": "😂😂😂", "created_at": "2025-12-04T12:33:25", "owner": "woodward361", "likes": 0}, {"id": 18338244901232987, "text": "My 8-year-old son understood and laughed", "created_at": "2025-12-04T12:31:10", "owner": "fromlatamtoeu", "likes": 0}, {"id": 18137655712467585, "text": "😂😂😂😂😂😂😂😂😂😂😂😂😂", "created_at": "2025-12-04T12:26:39", "owner": "erhimejuvie", "likes": 0}, {"id": 18009694175651387, "text": "🤣😍", "created_at": "2025-12-04T12:26:32", "owner": "lashandraedmonds", "likes": 0}, {"id": 18296869552286242, "text": "", "created_at": "2025-12-04T12:21:08", "owner": "armstrong_a123", "likes": 0}, {"id": 18540446767008772, "text": "😭😭😭😭", "created_at": "2025-12-04T12:17:42", "owner": "stefaniegiampaolo", "likes": 0}, {"id": 18049331963693969, "text": "", "created_at": "2025-12-04T12:17:00", "owner": "lgyessuh", "likes": 0}, {"id": 18305328241280094, "text": "", "created_at": "2025-12-04T12:14:04", "owner": "luffy_desu__", "likes": 0}, {"id": 18089986304487290, "text": "Dangg😭☠️", "c