, "owner": "zahra_alqadasi", "likes": 0}, {"id": 17878399809437098, "text": "🤣🤣🤣🤣🤣", "created_at": "2025-11-30T10:41:32", "owner": "julesminihan1976", "likes": 0}, {"id": 18080805281144615, "text": "", "created_at": "2025-11-30T10:41:03", "owner": "alexkonstantinovich10", "likes": 0}, {"id": 18045521006695058, "text": "🤣🤣🤣", "created_at": "2025-11-30T10:40:54", "owner": "iamdemola1", "likes": 0}, {"id": 18087529402960123, "text": "😂😂😂Valid!", "created_at": "2025-11-30T10:40:10", "owner": "palesa_tshabalala_", "likes": 0}, {"id": 18183567829350844, "text": "🤣🤣🤣🤣🤣", "created_at": "2025-11-30T10:39:57", "owner": "raffimeurer", "likes": 0}, {"id": 18275794366304885, "text": "He sixed on the seven for our sins", "created_at": "2025-11-30T10:39:12", "owner": "wilsbert", "likes": 0}, {"id": 17993850680846425, "text": "as if you people don't mock the messiah enough now you want to cheapen him to a meme, shame on you", "created_at": "2025-11-30T10:38:42", "owner": "faissalibnn", "likes": 0}, {"id": 18543423970028069, "text": "😂😂😂😂😂😂😂", "created_at": "2025-11-30T10:37:57", "owner": "desi_chorbadzhiyska", "likes": 0}, {"id": 18073626113255166, "text": "🤣🤣🤣", "created_at": "2025-11-30T10:37:15", "owner": "woo8430", "likes": 0}, {"id": 18073052606348183, "text": "", "created_at": "2025-11-30T10:37:06", "owner": "toneonlyphotography", "likes": 0}, {"id": 17980422056938127, "text": "🤣🤣🤣🤣", "created_at": "2025-11-30T10:37:05", "owner": "coffeefirstchaosafter", "likes": 0}, {"id": 18078032473944928, "text": "", "created_at": "2025-11-30T10:36:07", "owner": "__dj_31", "likes": 0}, {"id": 17857716252560853, "text": "🤣🤣😭😭😭😭🤣🤣", "created_at": "2025-11-30T10:35:52", "owner": "loagooo", "likes": 1}, {"id": 18073006322341205, "text": "😂😂😂😂", "created_at": "2025-11-30T10:35:23", "owner": "themiratalks", "likes": 0}, {"id": 18052452521665412, "text": "@evacashman_ @sophie_cashman", "created_at": "2025-11-30T10:34:58", "owner": "valerie.cashman.7", "likes": 0}, {"id": 18120120388554092, "text": "😂😂😂😂😂", "created_at": "2025-11-30T10:33:52", "owner": "therealbrinaaaaa", "likes": 0}, {"id": 17944859180949250, "text": "🤣", "created_at": "2025-11-30T10:33:04", "owner": "rakhi_s1ngh", "likes": 0}, {"id": 17871112764467960, "text": "", "created_at": "2025-11-30T10:32:29", "owner": "_mousam47", "likes": 0}, {"id": 17865598290511784, "text": "😂😂😂", "created_at": "2025-11-30T10:32:23", "owner": "dtobiloba34", "likes": 2}, {"id": 17888596176263318, "text": "😭😭😭😭😂😂😂😂🤣🤣🤣", "created_at": "2025-11-30T10:31:36", "owner": "taptuani", "likes": 0}, {"id": 18539717035028909, "text": "😂😂", "created_at": "2025-11-30T10:31:03", "owner": "akshaykumarsasidharan", "likes": 0}, {"id": 17918634126215548, "text": "So, not demonic?", "created_at": "2025-11-30T10:30:53", "owner": "chattycathyal", "likes": 0}, {"id": 17950263266916857, "text": "😂", "created_at": "2025-11-30T10:29:33", "owner": "zimmy.life", "likes": 0}, {"id": 18026058494584537, "text": "", "created_at": "2025-11-30T10:29:21", "owner": "alexabeams", "likes": 0}, {"id": 17856936597512375, "text": "politest 6-7 ever", "created_at": "2025-11-30T10:29:02", "owner": "amritonline24", "likes": 0}, {"id": 17887769985268917, "text": "😂", "created_at": "2025-11-30T10:27:26", "owner": "iasminabojinescu", "likes": 0}, {"id": 17875853394448808, "text": "😂", "created_at": "2025-11-30T10:25:31", "owner": "amahree._", "likes": 0}, {"id": 18077691356237069, "text": "😂😂😂", "created_at": "2025-11-30T10:25:21", "owner": "kravingsbydaniella", "likes": 0}, {"id": 17886932190400460, "text": "@sydatull six sevennnnn", "created_at": "2025-11-30T10:24:38", "owner": "jazzzy.gram", "likes": 0}, {"id": 18086257090840513, "text": "", "created_at": "2025-11-30T10:23:42", "owner": "wendymeihli", "likes": 6}, {"id": 17935918764102626, "text": "😂😂😂", "created_at": "2025-11-30T10:23:28", "owner": "folake.xx", "likes": 0}, {"id": 17916767406234052, "text": "", "created_at": "2025-11-30T10:22:37", "owner": "subrat_noob123", "likes": 0}, {"id": 18085775696006713, "text": "His eyes were like COAL, feet like COPPER, hair like WOOL. Stop lieing to that baby. That's not JESUS the way he was described in the Bible", "created_at": "2025-11-30T10:22:05", "owner": "palmtree1204", "likes": 0}, {"id": 18082832102010875, "text": "", "created_at": "2025-11-30T10:21:46", "owner": "hassoon3k", "likes": 0}, {"id": 18390707278183956, "text": "😮😮", "created_at": "2025-11-30T10:21:01", "owner": "halfblueeyes", "likes": 0}, {"id": 18382163239148974, "text": "The only time I'm letting a 67 joke slide...", "created_at": "2025-11-30T10:20:31", "owner": "aymen__ftw", "likes": 0}, {"id": 17868934986475051, "text": "", "created_at": "2025-11-30T10:20:27", "owner": "ralstonmendes", "likes": 0}, {"id": 18079955338923248, "text": "He's so proud. Finally someone gets him! 😂😂", "created_at": "2025-11-30T10:19:56", "owner": "softkittiepaws.113", "likes": 0}, {"id": 17892619689370668, "text": "Noooo😭💔", "created_at": "2025-11-30T10:19:21", "owner": "sophie070706", "likes": 0}, {"id": 18104260459663400, "text": "", "created_at": "2025-11-30T10:17:56", "owner": "anonymousss175", "likes": 0}, {"id": 18104253766590694, "text": "", "created_at": "2025-11-30T10:16:38", "owner": "taha_tenshi", "likes": 0}, {"id": 18088291732788556, "text": "This is the only 6 7 joke that’s funny", "created_at": "2025-11-30T10:16:33", "owner": "____aasthaaaa", "likes": 1}, {"id": 18095554336844312, "text": "😂😂😂", "created_at": "2025-11-30T10:16:06", "owner": "luwiakamanz_", "likes": 0}, {"id": 18064441019184896, "text": "@paymeskrilla", "created_at": "2025-11-30T10:15:52", "owner": "_africansugar", "likes": 0}, {"id": 18086770588995468, "text": "LMFAOOO", "created_at": "2025-11-30T10:15:36", "owner": "hyacinthusqwq", "likes": 0}, {"id": 17917357182226525, "text": "Day 6 than day 7", "created_at": "2025-11-30T10:15:27", "owner": "ajprivat2", "likes": 0}, {"id": 18113370850586360, "text": "😂😂😂", "created_at": "2025-11-30T10:14:38", "owner": "phillipscott3281", "likes": 0}, 