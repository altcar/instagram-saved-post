ylazz_", "likes": 0}, {"id": 17941489917076110, "text": "Casi me quedo sin tears", "created_at": "2025-11-16T01:57:13", "owner": "sharon_3005j", "likes": 0}, {"id": 18079957559116226, "text": "", "created_at": "2025-11-16T01:40:19", "owner": "omikuji2025", "likes": 0}, {"id": 18539987599050277, "text": "😂😂", "created_at": "2025-11-15T23:49:36", "owner": "zebra.929241", "likes": 0}, {"id": 18073413299016526, "text": "Sabrina gonnacheckoutthecarpeter", "created_at": "2025-11-15T23:41:39", "owner": "lieke_liekpiek", "likes": 0}, {"id": 17986184168872085, "text": "Ela tá viva?", "created_at": "2025-11-15T22:50:45", "owner": "stay_yonglix415", "likes": 0}, {"id": 17868289482471893, "text": "", "created_at": "2025-11-15T21:45:25", "owner": "saraknupp3", "likes": 0}, {"id": 18105449887647070, "text": "", "created_at": "2025-11-15T21:16:23", "owner": "luce_lbrt", "likes": 0}, {"id": 18079224488176731, "text": "@angelica_maria_05_", "created_at": "2025-11-15T21:06:43", "owner": "angeliyou", "likes": 0}, {"id": 17860275120540370, "text": "", "created_at": "2025-11-15T15:55:10", "owner": "ray_nicolescu", "likes": 0}, {"id": 18319422868172570, "text": "😂😂", "created_at": "2025-11-15T15:23:34", "owner": "anvrofme", "likes": 0}, {"id": 18067809872080990, "text": "Ouch I heard that 😢ooooo", "created_at": "2025-11-15T11:09:36", "owner": "nylahstockford_", "likes": 0}, {"id": 18043902926704645, "text": "we made famous the right girl😻💖💖", "created_at": "2025-11-15T09:56:56", "owner": "francesca.g_", "likes": 0}, {"id": 17980433312930207, "text": "Sabrina carpenter was attached to the carpet", "created_at": "2025-11-15T09:20:29", "owner": "harperleonewell", "likes": 0}, {"id": 18084686327090466, "text": "lol 😂", "created_at": "2025-11-15T03:18:34", "owner": "pabichhope", "likes": 0}, {"id": 17900048397324618, "text": "😂", "created_at": "2025-11-13T19:27:45", "owner": "jocelynpacheco_1", "likes": 0}, {"id": 18085317175975384, "text": "❤️❤️❤️", "created_at": "2025-11-10T23:32:13", "owne