25T20:18:18", "owner": "ouz_int", "likes": 0}, {"id": 18074926798961730, "text": "Anything under a 4 GPA is a mess", "created_at": "2025-10-25T17:27:58", "owner": "importnumpyasnp_", "likes": 0}, {"id": 18530568175054952, "text": "@itz_pranav_______", "created_at": "2025-10-25T16:10:33", "owner": "vijayaesh_", "likes": 0}, {"id": 18081404417077270, "text": "@gtasan.exe", "created_at": "2025-10-25T16:00:22", "owner": "iamvarunkumar_v", "likes": 1}, {"id": 18361917142085333, "text": "I was the 0.88 guy", "created_at": "2025-10-25T15:11:42", "owner": "hamzaziakhan", "likes": 0}, {"id": 18066176552065697, "text": "@_sanyam.jain._", "created_at": "2025-10-25T15:09:25", "owner": "manan.lalwani08", "likes": 0}, {"id": 18427946605096109, "text": "@mehul.saxena08", "created_at": "2025-10-25T14:50:33", "owner": "ayushyada.v", "likes": 0}, {"id": 18053536358309154, "text": "", "created_at": "2025-10-25T14:17:10", "owner": "dagm.y_", "likes": 1}, {"id": 17918972508054274, "text": "@ronaks.haha", "created_at": "2025-10-25T13:17:43", "owner": "jayeshsonig", "likes": 0}, {"id": 17891479821223131, "text": "@fabulousboy603", "created_at": "2025-10-25T12:48:46", "owner": "hyd.e.n", "likes": 0}, {"id": 18001410017679271, "text": "@erfansnk", "created_at": "2025-10-25T12:13:37", "owner": "saadat.sanei", "likes": 0}, {"id": 17857717098478866, "text": "@sachitya.decerati 😝", "created_at": "2025-10-25T10:52:57", "owner": "keysnsush", "likes": 0}, {"id": 18082525987817873, "text": "The comments have made me feel sm better about my grades", "created_at": "2025-10-25T09:57:59", "owner": "arshadbadmash_", "likes": 1}, {"id": 18120633067522629, "text": "@mertt.ckm", "created_at": "2025-10-25T09:43:52", "owner": "gorkemhn", "likes": 0}, {"id": 17922220782157382, "text": "@contirstreek", "created_at": "2025-10-25T09:06:30", "owner": "kashifahhmed", "likes": 0}, {"id": 17885761758261671, "text": "@hariharan_s_k", "created_at": "2025-10-25T09:04:08", "owner": "kushalkarwa", "likes": 0}, {"id": 18084332800798113, "text": "@satyajeetk_1717 @krissh_24", "created_at": "2025-10-25T08:50:30", "owner": "pranav_bafna04", "likes": 0}, {"id": 18297478756258771, "text": "@aryanborad_284", "created_at": "2025-10-25T08:50:09", "owner": "iamrushabhsolanki", "likes": 0}, {"id": 18128383126491474, "text": "2/4 in Cs am i cooked?", "created_at": "2025-10-25T08:15:11", "owner": "lucas.guan_", "likes": 0}, {"id": 18087520480930490, "text": "High on 2.7", "created_at": "2025-10-25T06:37:07", "owner": "tahirbilal_5", "likes": 0}, {"id": 17924467539153514, "text": "@ace_.spade_", "created_at": "2025-10-25T06:20:40", "owner": "_.sushh.___", "likes": 1}, {"id": 18086126033303104, "text": "@armaan_v9.24 @_captured_one @arnav03 😂😂😂", "created_at": "2025-10-25T05:47:15", "owner": "fahim_imtiaz7", "likes": 0}, {"id": 17863993683490813, "text": "@alaukik188", "created_at": "2025-10-25T05:36:03", "owner": "bamboo_copter07", "likes": 0}, {"id": 18323693737245548, "text": "@p_e.rr_y", "created_at": "2025-10-25T05:22:28", "owner": "adityav_rdhansingh", "likes": 1}, {"id": 18073585553243139, "text": "Hell nah i better do by myself", "created_at": "2025-10-25T04:27:29", "owner": "whoisatash", "likes": 0}, {"id": 18539138473044119, "text": "@vivin06_gt 👏", "created_at": "2025-10-25T04:20:49", "owner": "harsh_ragul", "likes": 0}, {"id": 17911110084235491, "text": "@sankalpr57", "created_at": "2025-10-25T03:22:02", "owner": "poojanjaviya", "likes": 0}, {"id": 17965033598833417, "text": "@ritvik_2076", "created_at": "2025-10-25T02:09:56", "owner": "siddarth.pai", "likes": 0}, {"id": 18045245342678127, "text": "I still remember my thermodynamics class — the professor said we could form a group of any size, as long as the total GPA was under 10.5 😂\n\nThe problem was… I was a senior taking that class with sophomores. They all grouped up together, leaving just me and my friend — total GPA: 6.0 💀\n\nI complained to the professor, but she just smiled and said, “Rules are rules.”\n\nSo we went in angry and underdogs… and somehow ended up with the highest score in the final exam. 🔥😎", "created_at": "2025-10-25T00:59:01", "owner": "sarunpat.prk", "likes": 1}, {"id": 18149640490375098, "text": "never thought that i'll be in this phase in my life though🙏", "created_at": "2025-10-25T00:22:54", "owner": "wiraakurniaone_", "likes": 0}, {"id": 18024348530771388, "text": "@brarfateh__04 @vipan_grewal3 😂", "created_at": "2025-10-24T22:06:02", "owner": "sahil_maurya_", "likes": 2}, {"id": 17861431455513835, "text": "@never_2029", "created_at": "2025-10-24T21:21:49", "owner": "seven_hour_flight", "likes": 0}, {"id": 18080190626102191, "text": "Let me correct it it's 1.7", "created_at": "2025-10-24T21:02:47", "owner": "mharoonkhan7", "likes": 1}, {"id": 18320393392175076, "text": "", "created_at": "2025-10-24T20:34:19", "owner": "yffff_919", "likes": 0}, {"id": 18121685773457378, "text": "@zaifaayyy___ @mkhizarmajeed 😭", "created_at": "2025-10-24T20:02:13", "owner": "mightbearsal", "likes": 1}, {"id": 18079200971043109, "text": "@kshitij__vats me", "created_at": "2025-10-24T19:40:05", "owner": "vaibhav_dhir", "likes": 1}, {"id": 18087017755821870, "text": "good in engineering", "created_at": "2025-10-24T18:52:53", "owner": "o.m_61", "likes": 0}, {"id": 18068441510596723, "text": "2.7 the most hard working tbh", "created_at": "2025-10-24T18:42:52", "owner": "0_bukhalid", "likes": 1}, {"id": 18140945668448316, "text": "@atharva_0412 🥀", "created_at": "2025-10-24T17:46:07", "owner": "mahendra_patel.00", "likes": 2}, {"id": 18128177101487603, "text": "", "created_at": "2025-10-24T17:30:41", "owner": "rthr.aknsha.pvt", "likes": 0}, {"id": 18058881161213396, "text": "2.1 say less", "created_at": "2025-10-24T17:13:56", "owner": "ayazsmin_muaaz", "likes": 0}, {"id": 18044839085646146, "text": "Me", "created_at": "2025-10-24T17:11:27", "owner": "vivek.ofc_", "likes": 0}, {"id": 17846772165590901, "text": "😂😂😂😂", "created_at": "2025-10-24T17:04:20", "owner": "jeffi_8", "likes": 0}, {"i