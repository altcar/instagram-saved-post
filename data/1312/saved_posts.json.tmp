likes": 0}, {"id": 18068011561973332, "text": "@yulian.nanan2010", "created_at": "2025-09-06T22:34:22", "owner": "kate_hxw8529", "likes": 0}, {"id": 18050321633635089, "text": "Aonde vc foi baby kkkkkk", "created_at": "2025-09-06T21:38:47", "owner": "nepomucenoliviadutra", "likes": 0}, {"id": 18353358925094865, "text": "🤣🤣🤣🤣🤣🤣", "created_at": "2025-09-06T21:38:35", "owner": "nepomucenoliviadutra", "likes": 0}, {"id": 18126007216465967, "text": "That was her???", "created_at": "2025-09-06T21:33:09", "owner": "romeoloveto_2927", "likes": 1}, {"id": 18155536465379584, "text": "\"Where you think you're going baby?\" The hospital🎵", "created_at": "2025-09-06T21:04:53", "owner": "ps_stokic", "likes": 1}, {"id": 18478425061072555, "text": "Is she ok?????", "created_at": "2025-09-06T20:35:26", "owner": "sashfan5789", "likes": 0}, {"id": 18373946674179783, "text": "", "created_at": "2025-09-06T19:16:14", "owner": "death_sgame", "likes": 0}, {"id": 18112379590473873, "text": "This was the day espresso was made", "created_at": "2025-09-06T13:54:54", "owner": "living_thefreelife", "likes": 1}, {"id": 18042179513669804, "text": "\"Where you think your going baby\" 💀😭", "created_at": "2025-09-06T12:24:00", "owner": "ary_lafolle", "likes": 0}, {"id": 18057639074600505, "text": "Sinceramente: godo", "created_at": "2025-09-06T11:47:19", "owner": "tom_my_08", "likes": 0}, {"id": 17932096536094013, "text": "🤣🤣🤣😭😭😍", "created_at": "2025-09-06T11:09:02", "owner": "ivet_svarcova", "likes": 0}, {"id": 18040987832395575, "text": "Bbĥɓj jǰǰǰǰǰǰǰǰǰǰǰǰǰǰǰǰǰǰǰǰǰǰǰǰjǰǰq n b", "created_at": "2025-09-06T06:38:35", "owner": "petersmichelle513", "likes": 0}, {"id": 17947942194001029, "text": "First surgery ✅️", "created_at": "2025-09-06T06:11:24", "owner": "akshat_751", "likes": 1}, {"id": 18332047267227500, "text": "\"VOCÊ SE ESQUECEU QUE EU SOU CRENTEE\"", "created_at": "2025-09-06T03:32:48", "owner": "imbrenow", "likes": 0}, {"id": 18026835752524386, "text": "🤣🤣🤣🤣🤣🤣🤣", "created_at": "2025-09-06T03:18:07", "owner": "harlley_brian", "likes": 0}, {"id": 18056469491621058, "text": "The sijwce.", "created_at": "2025-09-06T02:35:18", "owner": "sonn3nsch31n", "likes": 0}, {"id": 17881327944264553, "text": "😂", "created_at": "2025-09-06T02:12:17", "owner": "spike_papi", "likes": 0}, {"id": 18101130526614203, "text": "Not the hat just sticking out", "created_at": "2025-09-06T01:57:34", "owner": "ariel_cheerleaderr", "likes": 1}, {"id": 18104496214576725, "text": "« A little respect for women can get you very very far ».\n\nBro you let her fall", "created_at": "2025-09-05T21:25:36", "owner": "laura_nadalin", "likes": 1}, {"id": 18520860298050766, "text": "", "created_at": "2025-09-05T19:33:07", "owner": "luca_achache", "likes": 0}, {"id": 17893177254335929, "text": "To bad she didn’t get hurt to the point where she’d never be able to sing again", "created_at": "2025-09-05T18:35:14", "owner": "christian_swiridoff_13", "likes": 1}, {"id": 17988120272845591, "text": "😂😂😂😂😂😂😂😂", "created_at": "2025-09-05T18:27:41", "owner": "monica_cerquera", "likes": 0}, {"id": 18071262137166375, "text": "", "created_at": "2025-09-05T17:42:39", "owner": "fudbol_editor1k", "likes": 0}, {"id": 17961995771975966, "text": "Whos the guy tho", "created_at": "2025-09-05T17:13:54", "owner": "l.aeee38", "likes": 2}, {"id": 17931523812093666, "text": "😍", "created_at": "2025-09-05T17:12:18", "owner": "eliaswue24", "likes": 0}, {"id": 17997396902817140, "text": "So thats why she kills men in here videos it all stemmed from this moment", "created_at": "2025-09-05T16:46:27", "owner": "jdhansen88", "likes": 1}, {"id": 18052466174241498, "text": "10 years later she sang espresso", "created_at": "2025-09-05T15:51:50", "owner": "zaczacharper", "likes": 0}, {"id": 18003851633802020, "text": "Maybe this is why all the men in her music videos always die", "created_at": "2025-09-05T15:51:13", "owner": "jack_grayden", "likes": 1}, {"id": 18052900199540341, "text": "Call me a hospital maybe 😱😅😅", "created_at": "2025-09-05T14:47:30", "owner": "marianarojas6411", "likes": 0}, {"id": 17859137442483639, "text": "Haha lol", "created_at": "2025-09-05T14:41:29", "owner": "kmiecic_12", "likes": 0}, {"id": 17901713238125885, "text": "namee song plis😭", "created_at": "2025-09-05T14:23:42", "owner": "gwacieemmppp", "likes": 0}, {"id": 18092230171665517, "text": "Even earlier... look up rumor ... collaboration with a kid named finn...", "created_at": "2025-09-05T14:12:36", "owner": "hockeydadoef2013", "likes": 0}, {"id": 17854815918522277, "text": "", "created_at": "2025-09-05T13:57:33", "owner": "dhoeclara", "likes": 0}, {"id": 17879490885390454, "text": "😂😂😂", "created_at": "2025-09-05T13:51:40", "owner": "joseramirezosorto504", "likes": 0}, {"id": 18056667848528736, "text": "", "created_at": "2025-09-05T13:40:32", "owner": "noe_riva6611", "likes": 0}, {"id": 18062702894593253, "text": "😭", "created_at": "2025-09-05T13:12:11", "owner": "tasyaachmad15", "likes": 0}, {"id": 18528116122020850, "text": "", "created_at": "2025-09-05T11:48:43", "owner": "giorgiabuashvili7", "likes": 0}, {"id": 17964863579800909, "text": "He knocked the espresso out of her help 😭😭", "created_at": "2025-09-05T11:28:08", "owner": "imad_chehimi____", "likes": 0}, {"id": 17915019615172583, "text": "😂😂😂😂😂", "created_at": "2025-09-05T11:22:38", "owner": "stariinightfall24", "likes": 0}, {"id": 18078898414783122, "text": "To the hospital", "created_at": "2025-09-05T08:58:37", "owner": "bugi_no.1", "likes": 0}, {"id": 18072582899122304, "text": "That was a whole ass finisher move", "created_at": "2025-09-05T08:07:34", "owner": "crookshankmc69", "likes": 0}, {"id": 18133777825450205, "text": "Sabrina carpet", "created_at": "2025-09-05T06:54:07", "owner": "ali._.heid", "likes": 0}, {"id": 18089060116810346, "text": "Krl essa doeu em mim", "created_at": "2025-09-05T05:41:53", "owner": "arthur_resmini", "likes": 0}, {"id": 18154590490383151, "text": "Baby Sabrina", "created_at": "2025-09-05T05:30:46", "owner": "da