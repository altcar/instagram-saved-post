inatiion", "likes": 0}, {"id": 18067263677601863, "text": "@anish_56138", "created_at": "2025-10-24T13:36:13", "owner": "shivam__igl", "likes": 0}, {"id": 18097499935741085, "text": "Im that guy", "created_at": "2025-10-24T13:04:00", "owner": "saidasgrv", "likes": 0}, {"id": 17902581603147366, "text": "@navreetrandhawa._", "created_at": "2025-10-24T12:45:17", "owner": "chaitanyapaul._", "likes": 0}, {"id": 18044216012695036, "text": "@jainkhushi_071", "created_at": "2025-10-24T12:07:11", "owner": "gauriimj", "likes": 0}, {"id": 18301630852254246, "text": "I am the 2.7 gpa guy .. nice to meet you 🤝", "created_at": "2025-10-24T12:01:45", "owner": "youssif.esam.elnahas", "likes": 0}, {"id": 18079251179105370, "text": "@itanico_21 das bist du", "created_at": "2025-10-24T11:32:29", "owner": "thuannywon_savage", "likes": 0}, {"id": 18316152016170186, "text": "2.7 and 1.7 great match 🥀", "created_at": "2025-10-24T11:18:47", "owner": "men_r_brave___", "likes": 1}, {"id": 18076735208147070, "text": "@_nikkhil_.09", "created_at": "2025-10-24T11:05:26", "owner": "the_apratim21", "likes": 0}, {"id": 18078402005151193, "text": "@mriteshhh", "created_at": "2025-10-24T11:04:07", "owner": "royalboss.me", "likes": 0}, {"id": 18049710068658321, "text": "I think people didn't get that 2.7 is out of 10 🤡", "created_at": "2025-10-24T10:17:39", "owner": "sid.g1707", "likes": 3}, {"id": 18157720645393668, "text": "Meanwhile 2.4gpa students with internships n jobs :)))", "created_at": "2025-10-24T10:16:50", "owner": "z0haib._f7", "likes": 0}, {"id": 17921931636188635, "text": "Getting a 2.7/4.0 ain't high people 😭💔🥀", "created_at": "2025-10-24T10:02:21", "owner": "darrius.ac07", "likes": 0}, {"id": 18118224913524626, "text": "@viinayyy___", "created_at": "2025-10-24T10:01:08", "owner": "oh_.arjunaa", "likes": 1}, {"id": 18070672088349145, "text": "Bro, I got 2.3", "created_at": "2025-10-24T09:22:56", "owner": "f4hjq", "likes": 0}, {"id": 18116132068542188, "text": "@chirxg_____", "created_