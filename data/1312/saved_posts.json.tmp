48974125206521, "text": "", "created_at": "2025-11-22T01:53:27", "owner": "sillymanneeddogmetal", "likes": 0}, {"id": 18083078810289709, "text": "I can really get behind that last card", "created_at": "2025-11-22T01:40:43", "owner": "jovan_9274", "likes": 0}, {"id": 18095228482872344, "text": "Futas?", "created_at": "2025-11-22T01:34:52", "owner": "sugirokimimame14", "likes": 0}, {"id": 18081561749030439, "text": "Wth milf bro", "created_at": "2025-11-22T01:33:51", "owner": "koecheng_5469", "likes": 0}, {"id": 18098832793786903, "text": "", "created_at": "2025-11-22T01:27:17", "owner": "davd_.04", "likes": 0}, {"id": 18246067177294192, "text": "", "created_at": "2025-11-22T01:23:38", "owner": "best_hunter20", "likes": 0}, {"id": 18315172549219096, "text": "", "created_at": "2025-11-22T01:16:33", "owner": "wowbert2", "likes": 0}, {"id": 17867690958421118, "text": "", "created_at": "2025-11-22T01:14:16", "owner": "silverrr_gemini", "likes": 3}, {"id": 18106150633628601, "text": "FUTAS🔥", "created_at": "2025-11-22T01:13:11", "owner": "lollipop_j.x", "likes": 1}, {"id": 17862418866455405, "text": "", "created_at": "2025-11-22T01:01:57", "owner": "razor.fm", "likes": 1}, {"id": 18091310641904884, "text": "", "created_at": "2025-11-22T00:55:02", "owner": "pedrofioravanso", "likes": 0}, {"id": 18114682453564885, "text": "", "created_at": "2025-11-22T00:50:42", "owner": "almeida.dv77", "likes": 0}, {"id": 17852296509586040, "text": "", "created_at": "2025-11-22T00:49:26", "owner": "maruc3lino", "likes": 0}, {"id": 18081762209030449, "text": "", "created_at": "2025-11-22T00:36:53", "owner": "s.tier.nick", "likes": 0}, {"id": 17899695516335449, "text": "How did I get here", "created_at": "2025-11-22T00:35:03", "owner": "brandon_is_real", "likes": 0}, {"id": 17986908920864511, "text": "", "created_at": "2025-11-22T00:33:10", "owner": "danielsantos._.2006", "likes": 0}, {"id": 18369063208087013, "text": "You mean that kind of futas?", "created_at": "2025-11-22T00:31:46", "owner": "spawn9669", "likes": 0}, {"id": 17971973618967623, "text": "", "created_at": "2025-11-22T00:28:59", "owner": "logan.wwz", "likes": 0}, {"id": 18365954941094753, "text": "", "created_at": "2025-11-22T00:25:43", "owner": "lucass._monteiroo", "likes": 0}, {"id": 17905726377277566, "text": "Fact, Fact, Fact, ¿Fact?", "created_at": "2025-11-22T00:13:10", "owner": "jostin_leandro2", "likes": 0}, {"id": 18026001245777047, "text": "How does this child know what funatari is", "created_at": "2025-11-22T00:12:36", "owner": "dutchvanderplann", "likes": 0}, {"id": 18055308479643395, "text": "", "created_at": "2025-11-21T23:56:59", "owner": "obretas_", "likes": 0}, {"id": 18057619667294675, "text": "", "created_at": "2025-11-21T23:45:58", "owner": "mi_lo7737", "likes": 0}, {"id": 17998801430839479, "text": "", "created_at": "2025-11-21T23:29:54", "owner": "daikaiju_368", "likes": 0}, {"id": 17965888971003515, "text": "Did bro just say futas?", "created_at": "2025-11-21T23:28:12", "owner": "x_0_iv", "likes": 0}, {"id": 18336671095240086, "text": "He's so real for the futa part", "created_at": "2025-11-21T23:20:21", "owner": "real_demon_panda", "likes": 0}, {"id": 18101134132668654, "text": "No", "created_at": "2025-11-21T23:19:31", "owner": "mrclean9001", "likes": 0}, {"id": 18097218325837955, "text": "", "created_at": "2025-11-21T23:18:13", "owner": "daniel_pro_gameplays_", "likes": 0}, {"id": 18157055272406443, "text": "", "created_at": "2025-11-21T23:09:09", "owner": "juanvega.97", "likes": 0}, {"id": 18112683184599355, "text": "Me 2", "created_at": "2025-11-21T23:02:50", "owner": "viktor_.hugoo", "likes": 0}, {"id": 17978131853934225, "text": "Futa you say?", "created_at": "2025-11-21T23:01:48", "owner": "awesomesilverfan", "likes": 0}, {"id": 18388646560178891, "text": "What a niche pick, to say futa", "created_at": "2025-11-21T22:37:33", "owner": "h4t3_j3ws777", "likes": 0}, {"id": 18085949500980067, "text": "", "created_at": "2025-11-21T22:36:13", "owner": "giammy1110",