7868190350, "text": "😭😭", "created_at": "2025-11-30T07:09:21", "owner": "whynotjun1orr", "likes": 0}, {"id": 18063181133188585, "text": "😂😂😂😂 she's right though😂😂😂", "created_at": "2025-11-30T07:10:43", "owner": "eng.mariam.azzam", "likes": 0}, {"id": 18064199048531296, "text": "😂😂😂", "created_at": "2025-11-30T07:02:29", "owner": "bur_cu.h", "likes": 0}, {"id": 18064441595423284, "text": "😂😂😂", "created_at": "2025-11-30T07:03:16", "owner": "myserenitydesigns", "likes": 0}, {"id": 18064588493175947, "text": "@ambieebaby", "created_at": "2025-11-30T06:56:38", "owner": "ashleemshelton", "likes": 1}, {"id": 18065225318395138, "text": "😂😂😂", "created_at": "2025-11-30T07:01:54", "owner": "itsaboutmyordinarylife", "likes": 0}, {"id": 18068130275380134, "text": "We are doomed", "created_at": "2025-11-30T07:18:43", "owner": "magarcia753", "likes": 1}, {"id": 18073587629460491, "text": "😂😂😂\nShe is my favorite girl in the WHOLE entire planet !!!!! \n\n😍😍😍😍", "created_at": "2025-11-30T06:52:33", "owner": "georgiavargas", "likes": 0}, {"id": 18074885009585337, "text": "😭😭😭😭😭😭", "created_at": "2025-11-30T07:17:29", "owner": "c0zzy.cat", "likes": 0}, {"id": 18075027722191251, "text": "What she said?", "created_at": "2025-11-30T07:00:13", "owner": "thebrandfoto_studio", "likes": 0}, {"id": 18075424099998754, "text": "😂😂😂😂", "created_at": "2025-11-30T07:09:10", "owner": "19yiyi", "likes": 0}, {"id": 18079201897902596, "text": "I'm calling cps", "created_at": "2025-11-30T06:45:27", "owner": "randtherad", "likes": 0}, {"id": 18083566637120324, "text": "", "created_at": "2025-11-30T07:08:18", "owner": "audrey.raam", "likes": 0}, {"id": 18083839397034653, "text": "On today’s episode of good luck Charlie", "created_at": "2025-11-30T07:16:27", "owner": "blo420pm", "likes": 0}, {"id": 18086646928824535, "text": "😂😂😂😂", "created_at": "2025-11-30T06:52:26", "owner": "exotiic_linda", "likes": 0}, {"id": 18086863291971976, "text": "noo charlieee 😂😂😂", "created_at": "2025-11-30T06:56:32", "owner": "mahaputra", "likes": 0}, {"id": 18089805980509472, "text": "😂😂😂😂😂😂😂", "created_at": "2025-11-30T07:14:41", "owner": "50_shades_of_maryjane", "likes": 0}, {"id": 18091446469925033, "text": "Sin, heaven?", "created_at": "2025-11-30T06:56:50", "owner": "ahoy.shorty", "likes": 2}, {"id": 18114296005603734, "text": "😂😂😂😂", "created_at": "2025-11-30T07:16:22", "owner": "belle.deesse_", "likes": 0}, {"id": 18116192797563932, "text": "What the fuck did she say?", "created_at": "2025-11-30T07:10:03", "owner": "meagsy_22", "likes": 0}, {"id": 18127323109451801, "text": "", "created_at": "2025-11-30T07:01:33", "owner": "hey_you_your_finally_awake_05", "likes": 0}, {"id": 18133917493486933, "text": "Let me start this right here. All the kids in the world are saying June seventh. 🤷‍♀️", "created_at": "2025-11-30T07:18:37", "owner": "em__alex", "likes": 0}, {"id": 18174798655367512, "text": "", "created_at": "2025-11-30T06:51:48", "owner": "amani_benjamin19", "likes": 0}, {"id": 18185524684350326, "text": "😂😂😂", "created_at": "2025-11-30T07:03:44", "owner": "__itskatelyn", "likes": 0}, {"id": 18198180211325029, "text": "Please explain me what 6-7 is 😢", "created_at": "2025-11-30T06:56:59", "owner": "_darya_prmk_", "likes": 1}, {"id": 18201461797321626, "text": "", "created_at": "2025-11-30T07:15:13", "owner": "jts9992025", "likes": 0}, {"id": 18203387596316433, "text": "😂😂", "created_at": "2025-11-30T07:23:45", "owner": "jonpaulthedon", "likes": 0}, {"id": 18211209886314069, "text": "Ok i feel like and idiot but CAN SOMEONE EXPLAIN THE 6,7 JOKE TO ME ? Ive seen it around a lot but i dknt know what it is 😂😂😂", "created_at": "2025-11-30T07:17:41", "owner": "johns_violin", "likes": 0}, {"id": 18292553320273443, "text": "🤣🤌🏽 Yeshua 😎", "created_at": "2025-11-30T07:01:39", "owner": "timetravelerjah", "likes": 0}, {"id": 18321483448173445, "text": "", "created_at": "2025-11-30T07:06:49", "owner": "kush_borkhataria", "likes": 1}, {"id": 18388046848199273, "text": "", "created_at": "2025-11-30T06:59:46", "owner": "icewoozy", "likes": 0}, {"id": 18397186792123159, "text": "😂😂😂", "created_at": "2025-11-30T07:01:01", "owner": "mrspdsteele", "likes": 0}, {"id": 18496914274077851, "text": "😂😂", "created_at": "2025-11-30T06:59:01", "owner": "manpreet._.singh1998", "likes": 0}, {"id": 18542701858040902, "text": "😂😂😂", "created_at": "2025-11-30T06:44:32", "owner": "envy_de_gonzalez", "likes": 0}, {"id": 18549278395011685, "text": "😂😂😂😂", "created_at": "2025-11-30T06:45:12", "owner": "101_frenchies_tx_rachel", "likes": 0}, {"id": 17844396132620977, "text": "I heard FIX HEAVEN 😂", "created_at": "2025-11-30T06:33:39", "owner": "bari_tomz", "likes": 0}, {"id": 17858156751558597, "text": "😂😂😂", "created_at": "2025-11-30T06:26:47", "owner": "brickracers_speedway", "likes": 32}, {"id": 17860792836477987, "text": "This would have been an instant vine classic", "created_at": "2025-11-30T06:41:16", "owner": "maddddyyyy01", "likes": 0}, {"id": 17863259793458954, "text": "😂😂😂", "created_at": "2025-11-30T06:42:19", "owner": "mitchellgy", "likes": 0}, {"id": 17864412723517439, "text": "", "created_at": "2025-11-30T06:19:48", "owner": "bryantglo", "likes": 0}, {"id": 17882279598422176, "text": "🤣🤣💀", "created_at": "2025-11-30T06:29:51", "owner": "shari_alnajjar", "likes": 0}, {"id": 17890544877382008, "text": "😂😂", "created_at": "2025-11-30T06:23:16", "owner": "wij_1119", "likes": 0}, {"id": 17906911401269772, "text": "God: Hey Jesus, how many days should I take to crate the earth?\nJesus: idk Dad, 6-7?", "created_at": "2025-11-30T06:38:53", "owner": "s_velazquez", "likes": 0}, {"id": 17913755391252432, "text": "", "created_at": "2025-11-30T06:22:34", "owner": "soundslikebread", "likes": 84}, {"id": 17915540823090397, "text": "Bro I am dying! 😂😂. Cause He really doing it!", "created_at": "2025-11-30T06:42:34", "owner": "nurse_joe90", "likes": 0}, {"id": 17924787468187258, "text": "☠️☠️☠️", "created_at": "2025-11-30T06:20:17", "owner": "allysun_24", "likes": 0}, {"id": 17929358325018016, "text": "😂😂😂😂😂", "created_at": "2025-11-30T06:28:50", "owner": "i.heart.trey", "likes": 0}, {"id": 17932101573130674, "text": "😂😂😂", "created_at": "2025-11-30T06:34:24", "owner": "sangabz", "likes": 0}, {"id": 17952699069044724, "text": "Took Noah 6-7 days to build the ark", "created_at": "2025-11-30T06:34:49", "owner": "02andrea21_", "likes": 0}, {"id": 17953892589019728, "text": "6/7 is demonic.", "created_at": "2025-11-30T06:22:00", "owner": "cynthiablumenkrantz", "likes": 0}, {"id": 17966144334002400, "text": "😂😂😂😂😂😂😂😂😂😂😂", "created_at": "2025-11-30T06:36:25", "owner": "jamesmak_95", "likes": 0}, {"id": 17969174063830707, "text": "😂😂", "created_at": "2025-11-30T06:35:14", "owner": "nchambz", "likes": 0}, {"id": 17976338333949678, "text": "😂😂", "created_at": "2025-11-30T06:22:47", "owner": "mjfanrn", "likes": 0}, {"id": 17988643979907461, "text": "😂😂😂😂", "created_at": "2025-11-30T06:16:19", "owner": "mamiana2u", "likes": 2}, {"id": 17992736756895352, "text": "Being the whitest man the whole middle east has ever seen..", "created_at": "2025-11-30T06:42:40", "owner": "harmaankiven_sheriffi", "likes": 0}, {"id": 18011575919641245, "text": "😂😂😂😂😂", "created_at": "2025-11-30T06:24:25", "owner": "shaniece_ranae", "likes": 0}, {"id": 18026812805582043, "text": "", "created_at": "2025-11-30T06:28:47", "owner": "h___w___j", "likes": 0}, {"id": 18029484050758047, "text": "I see no lies! She is right 😂", "created_at": "2025-11-30T06:30:23", "owner": "hwatteok.stars", "likes": 0}, {"id": 18030751595746268, "text": "", "created_at": "2025-11-30T06:34:35", "owner": "mahamudul8611", "likes": 0}, {"id": 18032205962740645, "text": "Proof Jesus was a weekend guy", "created_at": "2025-11-30T06:21:34", "owner": "zhy.rl", "likes": 0}, {"id": 18046456169693504, "text": "😂😂😂", "created_at": "2025-11-30T06:27:54", "owner": "cccharrry", "likes": 0}, {"id": 18049571831396867, "text": "😂😂😂😂", "created_at": "2025-11-30T06:27:22", "owner": "vanessa_a_blake", "likes": 0}, {"id": 18051086645376278, "text": "@chandlerpowell0 God is good", "created_at": "2025-11-30T06:26:01", "owner": "aj_e_hobson", "likes": 2}, {"id": 18051353168346264, "text": "", "created_at": "2025-11-30T06:34:36", "owner": "famjamz08", "likes": 0}, {"id": 18051876926352429, "text": "😂😂😂😂", "created_at": "2025-11-30T06:14:55", "owner": "maryumm.6.muzammil", "likes": 0}, {"id": 18060796847246122, "text": "My kid is always say this numbers. I don’t where is this coming from?", "created_at": "2025-11-30T06:22:51", "owner": "icehulu", "likes": 0}, {"id": 18065270417153301, "text": "😂😂😂😂", "created_at": "2025-11-30T06:23:33", "owner": "dubmayne", "likes": 0}, {"id": 18065624126622370, "text": "😂😂😂", "created_at": "2025-11-30T06:22:54", "owner": "hayyyliecarlson", "likes": 0}, {"id": 18069550673620383, "text": "😂😂😂😂", "created_at": "2025-11-30T06:40:06", "owner": "karian_d", "likes": 0}, {"id": 18072715544039862, "text": "And on the 6th or 7th day Jesus rose from the dead", "created_at": "2025-11-30T06:41:16", "owner": "logan19pederson", "likes": 0}, {"id": 18077258152961170, "text": "😂😂😂😂", "created_at": "2025-11-30T06:25:03", "owner": "ebonynewby", "likes": 0}, {"id": 18077417500969242, "text": "😂😂😂😂", "created_at": "2025-11-30T06:14:38", "owner": "fittr_with_pri", "likes": 1}, {"id": 18085607300487483, "text": "“Should I rest on day 6 or 7?”", "created_at": "2025-11-30T06:28:12", "owner": "tay_e_23", "likes": 0}, {"id": 18087329821975639, "text": "Pffft.. that’s Obi wan kenobi.", "created_at": "2025-11-30T06:35:30", "owner": "axnicely", "likes": 0}, {"id": 18089904544765012, "text": "😂😂😂😂😂😍😍😍😍", "created_at": "2025-11-30T06:20:26", "owner": "realmelantunes", "likes": 0}, {"id": 18090367138822089, "text": "Why is she giving the camera a death stare when it turns back around", "created_at": "2025-11-30T06:23:35", "owner": "michels.colin", "likes": 0}, {"id": 18092069818918161, "text": "Jesús is the goat", "created_at": "2025-11-30T06:38:02", "owner": "turtle_skewers_"