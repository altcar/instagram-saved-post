misterkennysilva", "likes": 0}, {"id": 18073897109253982, "text": "Don't call them futas bro!!! 🫡", "created_at": "2025-11-21T21:13:50", "owner": "stacys.buff.mom", "likes": 0}, {"id": 18083972789098536, "text": "", "created_at": "2025-11-21T21:10:40", "owner": "russell_mallari530", "likes": 0}, {"id": 17917728771212489, "text": "", "created_at": "2025-11-21T21:10:21", "owner": "russell_mallari530", "likes": 0}, {"id": 17977994411940777, "text": "", "created_at": "2025-11-21T21:09:14", "owner": "its_d_livlotan1556", "likes": 1}, {"id": 18127518076443545, "text": "Futa😍", "created_at": "2025-11-21T21:07:19", "owner": "skibi._d", "likes": 0}, {"id": 18114465055563858, "text": "", "created_at": "2025-11-21T21:03:03", "owner": "eatmakok", "likes": 0}, {"id": 17956486332001767, "text": "My brother", "created_at": "2025-11-21T21:02:25", "owner": "dggamer007k7", "likes": 0}, {"id": 18064683323385756, "text": "", "created_at": "2025-11-21T21:00:36", "owner": "meriot99", "likes": 0}, {"id": 17943728502088582, "text": "Hell yeah!", "created_at": "2025-11-21T21:00:20", "owner": "_lsgrit", "likes": 0}, {"id": 18086148982814894, "text": "Futas🔛🔝", "created_at": "2025-11-21T20:58:26", "owner": "iwan_nacryii", "likes": 1}, {"id": 17961550632006369, "text": "", "created_at": "2025-11-21T20:55:37", "owner": "cabeza_0078", "likes": 16}, {"id": 18182451157349259, "text": "No we need goth girls", "created_at": "2025-11-21T20:54:08", "owner": "krazz_ftf_", "likes": 0}, {"id": 17972883806800304, "text": "", "created_at": "2025-11-21T20:53:35", "owner": "maggiemcneil50", "likes": 0}, {"id": 18320619121168857, "text": "", "created_at": "2025-11-21T20:52:34", "owner": "gabeunderscore", "likes": 0}, {"id": 18368529799087079, "text": "Shes in the middle gang", "created_at": "2025-11-21T20:51:02", "owner": "tt_lakeo", "likes": 0}, {"id": 18051332096357102, "text": "", "created_at": "2025-11-21T20:50:57", "owner": "random_dalek_847", "likes": 0}, {"id": 18084161288090012, "text": "", "created_a