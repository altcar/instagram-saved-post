, {"id": 18544823947054257, "text": "❤️❤️❤️❤️❤️❤️", "created_at": "2025-12-04T10:40:09", "owner": "alseny8182", "likes": 1}, {"id": 18382045180146263, "text": "weird scenario", "created_at": "2025-12-04T10:39:58", "owner": "bettevoit", "likes": 1}, {"id": 17942153130094387, "text": "❤️❤️❤️❤️❤️❤️", "created_at": "2025-12-04T10:39:54", "owner": "ahmedanwar0001", "likes": 1}, {"id": 18055452185333870, "text": "Bom dia presidentes", "created_at": "2025-12-04T10:38:28", "owner": "mereoliveira100", "likes": 4}, {"id": 18072585950522351, "text": "Emoção", "created_at": "2025-12-04T10:38:26", "owner": "tefimariah2", "likes": 5}, {"id": 17927346771160612, "text": "Bienvenue en Chine, Monsieur le Président de la Liberté et du Romantisme.🇫🇷❤️", "created_at": "2025-12-04T10:38:18", "owner": "ch3n_al1k", "likes": 32}, {"id": 18213654250310993, "text": "👏🏻Bienvenue à Pékin👏🏻😙😙", "created_at": "2025-12-04T10:38:17", "owner": "horikitty928", "likes": 4}, {"id": 18032357636735635, "text": "", "created_at": "2025-12-04T10:37:55", "owner": "nhfcfggj7", "likes": 1}, {"id": 18097943776885361, "text": "La classe", "created_at": "2025-12-04T10:37:45", "owner": "luisprzvd", "likes": 3}, {"id": 18049933952397484, "text": "", "created_at": "2025-12-04T10:37:44", "owner": "nhfcfggj7", "likes": 1}, {"id": 18062707181197588, "text": "Du cinéma mdr😂😂😂😂😂", "created_at": "2025-12-04T10:37:39", "owner": "sam.wick77", "likes": 5}, {"id": 18075665102586623, "text": "", "created_at": "2025-12-04T10:37:19", "owner": "mfleandre", "likes": 16}, {"id": 17924273091046977, "text": "", "created_at": "2025-12-04T10:37:07", "owner": "nhfcfggj7", "likes": 3}, {"id": 18191449192349510, "text": "❤️🙌💙🤍❤️🇫🇷💙🤍❤️🙌👏", "created_at": "2025-12-04T10:37:05", "owner": "polarstern_circularity100", "likes": 4}, {"id": 18116382232576576, "text": "👏👏", "created_at": "2025-12-04T10:36:53", "owner": "edezekiel768", "likes": 3}, {"id": 17918109339227753, "text": "👏👏👏👏👏👏", "created_at": "2025-12-04T10:36:31", "owner": "acheckzai.officialpage", "likes": 0}, {"id": 17848034373584046, "text": "La Chine est un pays développé ; elle devrait aider la France, qui est en retard, à construire son économie et à moderniser le peuple français qui vit comme dans les années soixante-dix. Apprenez aux Français comment profiter des technologies modernes", "created_at": "2025-12-04T10:36:22", "owner": "worldo_drama_", "likes": 15}, {"id": 18156503227408556, "text": "A clown is born. Gardez le surtout", "created_at": "2025-12-04T10:36:18", "owner": "hannah_h72", "likes": 0}, {"id": 17916971139226671, "text": "🤡🤡🤡🤡🤡🤡🤡", "created_at": "2025-12-04T10:36:15", "owner": "lorenzoottaviani", "likes": 4}, {"id": 18083138453022257, "text": "❤️please help for positive and good hearts ❤️", "created_at": "2025-12-04T10:35:58", "owner": "nhfcfggj7", "likes": 0}, {"id": 17951536335065567, "text": "aww they are cheering “welcome! welcome”", "created_at": "2025-12-04T10:35:58", "owner": "lulu.m3n", "likes": 0}, {"id": 18061218962242591, "text": "😍😍😍👏👏👏❤️❤️❤️", "created_at": "2025-12-04T10:35:50", "owner": "miss_iraq_888a", "likes": 0}, {"id": 18011608532645822, "text": "✌️🇫🇷🇫🇷🇫🇷😘😘", "created_at": "2025-12-04T10:35:45", "owner": "fabinho_455", "likes": 0}, {"id": 17865148785518327, "text": "", "created_at": "2025-12-04T10:35:44", "owner": "yanis.sainte_livrade", "likes": 674}, {"id": 17953891164046938, "text": "", "created_at": "2025-12-04T10:35:39", "owner": "andronikaloumi", "likes": 0}, {"id": 18308970727268472, "text": "❤️😍❤️lovely ❤️thanks for everything ❤️", "created_at": "2025-12-04T10:35:34", "owner": "nhfcfggj7", "likes": 0}, {"id": 18112304863592952, "text": "Une belle lumière reflète notre France 🇨🇵. ❤️❤️❤️", "created_at": "2025-12-04T10:35:34", "owner": "melaniepnantes44", "likes": 39}, {"id": 17916939582229971, "text": "✌️🇨🇳🇨🇳🇫🇷🇫🇷", "created_at": "2025-12-04T10:35:29", "owner": "fabinho_455", "likes": 0}, {"id": 18119502472547764, "text": "❤️❤️❤️❤️❤️❤️❤️❤️❤️🙌🙌", "created_at": "2025-12-04T10:35:22", "owner": "realg