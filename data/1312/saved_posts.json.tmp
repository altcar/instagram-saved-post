row", "likes": 0}, {"id": 17933620566110570, "text": "🤣🤣🤣🤣", "created_at": "2025-12-01T15:51:44", "owner": "lor_xx", "likes": 1}, {"id": 17986920077876040, "text": "", "created_at": "2025-12-01T15:49:50", "owner": "kajko_998", "likes": 0}, {"id": 18178041490366354, "text": "", "created_at": "2025-12-01T15:46:57", "owner": "_swyv._", "likes": 1}, {"id": 18091644667937241, "text": "89!!!", "created_at": "2025-12-01T15:46:57", "owner": "ultraphotographybyj", "likes": 0}, {"id": 17922013509056120, "text": "🤣🤣", "created_at": "2025-12-01T15:46:24", "owner": "adulttalkwithgrandma", "likes": 1}, {"id": 18113068174588455, "text": "😂", "created_at": "2025-12-01T15:45:31", "owner": "thejrocshow", "likes": 0}, {"id": 18081076001513386, "text": "God worked for 6 days and on the 7th day he rested 🙃", "created_at": "2025-12-01T15:42:57", "owner": "lovisettophotography", "likes": 3}, {"id": 18082867082037543, "text": "💀", "created_at": "2025-12-01T15:41:59", "owner": "kevo4i4", "likes": 1}, {"id": 17861160054476021, "text": "Jesus：🤷🏼‍♂️", "created_at": "2025-12-01T15:41:50", "owner": "jo_osephl", "likes": 0}, {"id": 17900446203180097, "text": "DUDEEEE 💀💀", "created_at": "2025-12-01T15:41:39", "owner": "faseong.hyeon", "likes": 0}, {"id": 18061521140217854, "text": "😂😂", "created_at": "2025-12-01T15:40:52", "owner": "ray_luxi", "likes": 1}, {"id": 18076600745186926, "text": "peak comedy😭", "created_at": "2025-12-01T15:40:49", "owner": "dzakkijabbar", "likes": 1}, {"id": 18083805658878004, "text": "Bok six seven dua ediyo awk", "created_at": "2025-12-01T15:39:21", "owner": "yusufinin_4rakami", "likes": 0}, {"id": 18100739938689319, "text": "6-7 because god made the universe in 6days and rest on the seventh day Amen😍✝️", "created_at": "2025-12-01T15:39:16", "owner": "you_boy_kee67", "likes": 0}, {"id": 18192817447330667, "text": "@im_dontai", "created_at": "2025-12-01T15:39:10", "owner": "hldmyhhnds", "likes": 0}, {"id": 17880259518425965, "text": "😂😂", "created_at": "2025-12-01T15:38:09", "owner": "brujababymama", "likes": 0}, {"id": 18145828828447568, "text": "😂😂😂", "created_at": "2025-12-01T15:37:57", "owner": "bboyninjadance", "likes": 0}, {"id": 18101172439741384, "text": "😂😂😂😂😂😂😂😂😂😂", "created_at": "2025-12-01T15:37:40", "owner": "shohjaxongafforov", "likes": 0}, {"id": 18314341537247781, "text": "THE PROPHECY", "created_at": "2025-12-01T15:36:42", "owner": "aubreynazz", "likes": 0}, {"id": 18031159463769539, "text": "😂😂😂😂😂", "created_at": "2025-12-01T15:36:06", "owner": "titathebarber", "likes": 2}, {"id": 18065964029532034, "text": "", "created_at": "2025-12-01T15:35:53", "owner": "06_daniar", "likes": 0}, {"id": 18136188055464812, "text": "„Like six or seven deadly sins my children”", "created_at": "2025-12-01T15:34:14", "owner": "baggo6342", "likes": 0}, {"id": 18083748328861107, "text": "Created the earth in 6 days and rested on the 7th….valid! 😜", "created_at": "2025-12-01T15:34:10", "owner": "mommajo98", "likes": 0}, {"id": 18180714244361036, "text": "We are cursed 🤣😭", "created_at": "2025-12-01T15:34:05", "owner": "jessreana", "likes": 0}, {"id": 18069316889608624, "text": "This not funny", "created_at": "2025-12-01T15:33:19", "owner": "m1sha_00710", "likes": 0}, {"id": 18098296633805850, "text": "Guess what 6+7= 13. He knew all along. God's plan.", "created_at": "2025-12-01T15:32:45", "owner": "am_gurjeet_singh", "likes": 0}, {"id": 18076166756190672, "text": "89", "created_at": "2025-12-01T15:32:20", "owner": "carlitos_clav", "likes": 0}, {"id": 18431773552129940, "text": "Deuteronomy 6:7 to be exact lol", "created_at": "2025-12-01T15:31:29", "owner": "roxtran", "likes": 2}, {"id": 18049556996391014, "text": "", "created_at": "2025-12-01T15:29:55", "owner": "classy._.guna", "likes": 2}, {"id": 18091252405928468, "text": "😂", "created_at": "2025-12-01T15:28:57", "owner": "theregularnetwork", "likes": 0}, {"id": 18028595156568626, "text": "", "created_at": "2025-12-01T15:28:18", "owner": "nafiz77767_", "likes": 0}, {"id": 18069786821579510, "text": "🤦🏽‍♀️", "created_at": "2025-12-01T15:28:08", "owner": "roxy.mckoy", "likes": 1}, {"id": 17843630043627394, "text": "6,7😂😂😂😂😂", "created_at": "2025-12-01T15:27:56", "owner": "tarina_handoko", "likes": 1}, {"id": 17929550799078487, "text": "😂😂😂", "created_at": "2025-12-01T15:26:11", "owner": "aww_by_ash", "likes": 1}, {"id": 18071193206077450, "text": "😂😂", "created_at": "2025-12-01T15:24:34", "owner": "sendy.simon.7", "likes": 1}, {"id": 18085647335490593, "text": "@willitooo_", "created_at": "2025-12-01T15:23:44", "owner": "brauliorodriguez23", "likes": 0}, {"id": 18065137997612589, "text": "😂😂😂😂", "created_at": "2025-12-01T15:23:20", "owner": "anna__trojan", "likes": 1}, {"id": 18115296022600877, "text": "If this wasn’t staged funniest thing ever 😂", "created_at": "2025-12-01T15:22:39", "owner": "adeezysroom", "likes": 2}, {"id": 18127315273453584, "text": "You all realize you made your kids this stupid by giving them smart phones right out the oven, right? Like there’s only one way this happened.", "created_at": "2025-12-01T15:21:52", "owner": "cyanide_la_ru", "likes": 0}, {"id": 18096182113869889, "text": "I am dead 😂😂", "created_at": "2025-12-01T15:20:57", "owner": "rayahakob", "likes": 1}, {"id": 18049828997401349, "text": "🤣🤣🤣", "created_at": "2025-12-01T15:20:31", "owner": "mischief_managed_tc", "likes": 0}, {"id": 18101190925780046, "text": "😂😂😂😂", "created_at": "2025-12-01T15:19:34", "owner": "mz_lou_baby", "likes": 1}, {"id": 17905805994289042, "text": "💀", "created_at": "2025-12-01T15:18:33", "owner": "diae.bh", "likes": 0}, {"id": 18046260887469021, "text": "😂😂😂", "created_at": "2025-12-01T15:18:30", "owner": "torrie____", "likes": 0}, {"id": 17953810964908524, "text": "Explain me 😢", "created_at": "2025-12-01T15:16:28", "owner": "sharxz_2010", "likes": 0}, {"id": 18114830452575177, "text": "", "created_at": "2025-12-01T15:16:06", "owner": "ehleria", "likes": 0}, {"id": 18027808934573913, "text": "😂😂😂😂", "created_at": "2025-12-01T15:15:40", "owner": "_ndimamadu", "likes": 0}, {"id": 18101544424606959, "text": "", "created_at": "2025-12-01T15:14:58", "owner": "hunter.whiteside", "likes": 0}, {"id": 17867916111488486, "text": "I’min tears 😂😂😂😭😭😭😭😭😭", "created_at": "2025-12-01T15:14:46", "owner": "_its.nikkii_", "likes": 0}, {"id": 18140777314454459, "text": "😮🤣", "created_at": "2025-12-01T15:13:22", "owner": "luxnqolobe", "likes": 0}, {"id": 17893470153231075, "text": "", "created_at": "2025-12-01T15:13:05", "owner": "pascaldavid_cv", "likes": 0}, {"id": 18063237473536118, "text": "", "created_at": "2025-12-01T15:12:43", "owner": "nycollas.kaell", "likes": 0}, {"id": 18024044135783534, "text": "😂😂😂😂😂", "created_at": "2025-12-01T15:12:16", "owner": "titagodinho", "likes": 0}, {"id": 18049988840391964, "text": "JESUS? like dread lock, middle eastern Jesus, King of the Jews? Yea, no, thats um... Jason from down the street.", "created_at": "2025-12-01T15:11:42", "owner": "nicki5s", "likes": 1}, {"id": 18062034608620203, "text": "And it was written😪", "created_at": "2025-12-01T15:11:20", "owner": "daynebetrippn", "likes": 0}, {"id": 18091745311936999, "text": "😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂", "created_at": "2025-12-01T15:10:57", "owner": "nancynka666", "likes": 0}, {"id": 18087593432488230, "text": "💀💀", "created_at": "2025-12-01T15:10:48", "owner": "chahubilla", "likes": 0}, {"id": 18330863572243277, "text": "😂😂😂😂", "created_at": "2025-12-01T15:10:29", "owner": "the.xo.effect", "likes": 0}, {"id": 18016316585623050, "text": "", "created_at": "2025-12-01T15:10:21", "owner": "henrysartorioliveira", "likes": 394}, {"id": 18062793629443420, "text": "😭🤣🤣🤣🤣🤣", "created_at": "2025-12-01T15:10:07", "owner": "hannah_jayne89", "likes": 0}, {"id": 18071671298062810, "text": "😂😂😂😂😂😂😂", "created_at": "2025-12-01T15:09:26", "owner": "anything4lauren_", "likes": 0}, {"id": 17937542835097021, "text": "John 3: 67", "created_at": "2025-12-01T15:08:12", "owner": "sackid", "likes": 0}, {"id": 18014255654803013, "text": "😂😂😂😂😂😂😂😂😂", "created_at": "2025-12-01T15:07:30", "owner": "iamtyeg", "likes": 0}, {"id": 17950461941915724, "text": "😂", "created_at": "2025-12-01T15:06:27", "owner": "sherinjozef", "likes": 0}, {"id": 18066242462617515, "text": "“I just blessed’em on a Sunday, six seveennnnnn”", "created_at": "2025-12-01T15:06:22", "owner": "feliciatheroach", "likes": 1}, {"id": 18091317310897464, "text": "Execute her", "created_at": "2025-12-01T15:05:54", "owner": "htline182", "likes": 0}, {"id": 18085058459318687, "text": "", "created_at": "2025-12-01T15:05:17", "owner": "a7ex.popan", "likes": 0}, {"id": 17971592867975143, "text": "😮💀", "created_at": "2025-12-01T15:04:49", "owner": "bureau_m_v", "likes": 0}, {"id": 18401825611193164, "text": "", "created_at": "2025-12-01T15:04:40", "owner": "baboo9013", "likes": 0}, {"id": 17844113742615287, "text": "Numbers 6:7", "created_at": "2025-12-01T15:04:40", "owner": "rae.fen", "likes": 0}, {"id": 18067257068568789, "text": "@marlon.b2011 😂🤣", "created_at": "2025-12-01T15:03:45", "owner": "pisa25", "likes": 0}, {"id": 17997333440814739, "text": "😂😂😂", "created_at": "2025-12-01T15:03:34", "owner": "keeloyal06", "likes": 0}, {"id": 18044720954704541, "text": "", "created_at": "2025-12-01T15:02:37", "owner": "fad1lll_", "likes": 1}, {"id": 18080749442172950, "text": "🤣🤣🤣🤣🤣", "created_at": "2025-12-01T15:02:16", "owner": "evaassada_", "likes": 0}, {"id": 17926911594169639, "text": "", "created_at": "2025-12-01T15:01:58", "owner": "s1ber_hd", "likes": 0}, {"id": 18248466343294470, "text": "Amen👏.... 6 7 6 7 6 7🤑", "created_at": "2025-12-01T15:00:43", "owner": "krish_mad13", "likes": 0}, {"id": 18143344252445872, "text": "@sathwik.rao_11", "created_at": "2025-12-01T14:59:13", "owner": "akshith_kumar_yadav", "likes": 0}, {"id": 18091900159902136, "text": "😭", "created_at": "2025-12-01T14:58:50", "owner": "spidermarks_mj", "likes": 0}, {"id": 17868170304490920, "text": "He 67ed for our sins.", "created_at": "2025-12-01T14:58:12", "owner": "brandon.lives", "likes": 1}, {"id": 18379158295195312, "text": "", "created_at": "2025-12-01T14:57:53", "owner": "bw91j", "likes": 0}, {"id": 18067033436136487, "text": "C-Charlie f-from slender the arrival n-no NO NOT AGAIN NO", "created_at": "2025-12-01T14:57:16", "owner": "fallensky82", "likes": 0}, {"id": 17855528805571222, "text": "Proverbs 6:16", "created_at": "2025-12-01T14:56:23", "owner": "chabanelebitsa", "likes": 0}, {"id": 17922672021053484, "text": "😂", "created_at": "2025-12-01T14:55:21", "owner": "cookingwiththestrawhats", "likes": 0}, {"id": 17927311140157211, "text": "@laurenmariemoore 🤣🤣🤣", "created_at": "2025-12-01T14:55:11", "owner": "purdyclaire", "likes": 0}, {"id": 18079729642933611, "text": "😂😂", "created_at": "2025-12-01T14:54:55", "owner": "rob_get_bandz", "likes": 1}, {"id": 18186544822343724, "text": "Matthew 14:13 - 21\n“We have only 6 loaves of bread and 7 fish”", "created_at": "2025-12-01T14:53:38", "owner": "moiles69", "likes": 6}, {"id": 18157577533366244, "text": "What is this meme even about?", "created_at": "2025-12-01T14:53:15", "owner": "kittyzzv", "likes": 0}, {"id": 17972213588813680, "text": "@annarozenberg1 🤣", "created_at": "2025-12-01T14:52:15", "owner": "huisjeboompjeboys", "likes": 0}, {"id": 17868058062489189, "text": "Mormons?😆", "created_at": "2025-12-01T14:52:07", "owner": "powerofchange.nl", "likes": 1}, {"id": 17985211811867443, "text": "The way this is meme for the Christian and not a meme for Muslims shows u that there's something wrong here.....💀", "created_at": "2025-12-01T14:50:07", "owner": "chouaib_tid410", "likes": 0}, {"id": 18055330160324945, "text": "😂😂😂😂😂", "created_at": "2025-12-01T14:48:31", "owner": "jiji_benjamain", "likes": 2}, {"id": 18350624533203687, "text": "😂", "created_at": "2025-12-01T14:47:59", "owner": "dj_dipherent", "likes": 0}, {"id": 17917403916238586, "text": "I’ve never seen anyone so confident in an answer, with how quickly the pacifier goes back in 😂", "created_at": "2025-12-01T14:47: