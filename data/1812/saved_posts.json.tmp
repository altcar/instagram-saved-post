{"media_id": 3783249122862128076, "shortcode": "DSAzQhhAVvM", "permalink": "https://www.instagram.com/p/DSAzQhhAVvM/", "taken_at": "2025-12-08T18:28:20", "caption": "hello!!! my name is jordan and i work in the american formula series of indycar! i work with drivers and teams to help build brands and market themselves. if your dream is to work in motorsport; follow along! i love showing all the behind the scenes of my work! i started with zero experience, and i love showing you how i got here! \n\n#oscarpiastri #landonorris #mclarenf1 #formula1 #f1 #nascar #indycar #motorsports #abudhabi #abudhabif1 #abudhabigp #racing #sportsmarketing #creativeagency #photography #videography #maxverstappen #redbull #redbullracing #redbullf1 #womeninsports #womeninmotorsport #femalesinsport #businessowner #internship #studentjobs", "owner_username": "jordanagajanian", "owner_id": "10962120", "likes": 714, "is_video": true, "typename": "GraphVideo", "media": [{"type": "video", "path": "0022_DSAzQhhAVvM\\DSAzQhhAVvM_20251208_182820.mp4"}], "comments": [{"id": "18185700721351553", "text": "❤️❤️", "created_at": "2025-12-09T04:46:53", "owner": "haseebenterprises1", "likes": 0}, {"id": "17886351183405004", "text": "How does one get into the tech team? That’s a dream of mine is working with a formula team", "created_at": "2025-12-08T18:34:44", "owner": "afk_.jay", "likes": 0}, {"id": "18078901910332416", "text": "U needa do photography for emmmmm", "created_at": "2025-12-08T22:18:18", "owner": "sleepless_photos", "likes": 0}], "location": null, "hashtags": ["oscarpiastri", "landonorris", "mclarenf1", "formula1", "f1", "nascar", "indycar", "motorsports", "abudhabi", "abudhabif1", "abudhabigp", "racing", "sportsmarketing", "creativeagency", "photography", "videography", "maxverstappen", "redbull", "redbullracing", "redbullf1", "womeninsports", "womeninmotorsport", "femalesinsport", "businessowner", "internship", "studentjobs"]},
