: "2025-12-05T08:10:30", "owner": "ivebenjamin10", "likes": 0}, {"id": 18098737042696464, "text": "What show/YouTube channel is this😂", "created_at": "2025-12-04T12:57:51", "owner": "dannie.sb3", "likes": 0}, {"id": 17903191761162375, "text": "Racebook @4.99 🤣🤣", "created_at": "2025-12-03T11:30:21", "owner": "rahulshah.___", "likes": 0}, {"id": 18129573643498066, "text": "My cheeks hurt soo much😂😂😂😂😂😂", "created_at": "2025-12-02T17:41:06", "owner": "vivaanthewagle", "likes": 0}, {"id": 17993088983724156, "text": "\"our first app: racebook\" *cuts to a black woman*", "created_at": "2025-12-02T13:39:00", "owner": "aditya._.d3shmukh", "likes": 0}, {"id": 18048089465437918, "text": "😂😂😭", "created_at": "2025-12-01T13:58:15", "owner": "vaishnavi_priyanka27", "likes": 0}, {"id": 18363401251090922, "text": "He still sold😂👏", "created_at": "2025-11-30T17:13:53", "owner": "lil_psychyy", "likes": 0}, {"id": 17864823360515258, "text": "😂😂😂😂", "created_at": "2025-11-30T06:54:33", "owner": "chaitanya_krishhna", "likes": 0}, {"id": 18089947283504411, "text": "😂😂😂", "created_at": "2025-11-29T11:13:00", "owner": "hasindu_nimesh", "likes": 0}, {"id": 17994153359713911, "text": "PIERRIEEEETT LABS", "created_at": "2025-11-28T12:09:36", "owner": "thestoopid1", "likes": 0}, {"id": 18077731964519716, "text": "😂😂😂😂😂😂😂😂😂😂😂😂😂😂", "created_at": "2025-11-27T13:53:04", "owner": "legendheroe", "likes": 0}, {"id": 17975854079957294, "text": "He looks like kamala harris", "created_at": "2025-11-27T01:31:05", "owner": "xbuck302x", "likes": 0}, {"id": 18081698441031275, "text": "Racebook 😂😂😂😂", "created_at": "2025-11-26T21:05:51", "owner": "merzh0ev", "likes": 0}, {"id": 18086472655976909, "text": "Race book 😂😂😂", "created_at": "2025-11-26T09:15:51", "owner": "neemhakeem766", "likes": 0}, {"id": 17923540386186982, "text": "😂😂😂😂😂😂😂😂", "created_at": "2025-11-26T04:20:46", "owner": "cocoolyng", "likes": 0}, {"id": 17851000359595372, "text": "😂😂😂😂😂😂", "created_at": "2025-11-25T17:53:36", "owner": "itz_s