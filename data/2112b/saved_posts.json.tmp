kes": 0}, {"id": 17901347901318037, "text": "", "created_at": "2025-11-25T13:02:05", "owner": "yacopobarchiesi_", "likes": 0}, {"id": 18379969900195391, "text": "🐴🌈", "created_at": "2025-11-25T12:59:31", "owner": "felipe.rivera.sol.leusemio", "likes": 0}, {"id": 18086632918813863, "text": "", "created_at": "2025-11-25T12:58:07", "owner": "frank_situ", "likes": 0}, {"id": 17970288662817402, "text": "", "created_at": "2025-11-25T12:52:08", "owner": "angel.mora24", "likes": 0}, {"id": 17876222367442563, "text": "", "created_at": "2025-11-25T12:50:01", "owner": "jacobacrz", "likes": 0}, {"id": 18049835474401654, "text": "Pozor lebo ta budem chytat", "created_at": "2025-11-25T12:49:21", "owner": "_and.rej", "likes": 0}, {"id": 18187467859341694, "text": "Eat me", "created_at": "2025-11-25T12:47:01", "owner": "mynicka_69", "likes": 0}, {"id": 18302555761255307, "text": "И что", "created_at": "2025-11-25T12:45:19", "owner": "belozorov_egor", "likes": 0}, {"id": 18062696447530553, "text": "Holy fuck", "created_at": "2025-11-25T12:44:31", "owner": "xcelldraws", "likes": 0}, {"id": 18087804472783075, "text": "Hore", "created_at": "2025-11-25T12:37:17", "owner": "fukh.womina", "likes": 0}, {"id": 17870330664469980, "text": "how can a man be gay", "created_at": "2025-11-25T12:33:19", "owner": "posgresql", "likes": 0}, {"id": 18431733562108571, "text": "", "created_at": "2025-11-25T12:32:41", "owner": "mr_milklover", "likes": 6}, {"id": 18020789852606511, "text": "", "created_at": "2025-11-25T12:21:04", "owner": "2kristian27", "likes": 0}, {"id": 18349088911205842, "text": "", "created_at": "2025-11-25T12:19:47", "owner": "ningombamandrew", "likes": 1}, {"id": 17919239301211845, "text": "", "created_at": "2025-11-25T12:19:17", "owner": "joubilation", "likes": 0}, {"id": 17902471695165797, "text": "", "created_at": "2025-11-25T12:06:42", "owner": "not.momo67", "likes": 0}, {"id": 18075347135211530, "text": "", "created_at": "2025-11-25T11:49:33", "owner": "rubberdabeat2", "likes": 0}, {"id": 17882095728304925, "text": "", "created_at": "2025-11-25T11:15:36", "owner": "jesseruscito", "likes": 0}, {"id": 17970332447975947, "text": "", "created_at": "2025-11-25T10:42:48", "owner": "__mr.weekend", "likes": 0}, {"id": 18103564033672197, "text": "Hi Hannah 👋", "created_at": "2025-11-25T05:37:32", "owner": "codathen_shook_05", "likes": 0}, {"id": 18085564615971676, "text": "Look nice in your picture", "created_at": "2025-11-25T04:53:37", "owner": "andrewlee5609", "likes": 0}, {"id": 18049338536396713, "text": "JL BETTER", "created_at": "2025-11-25T03:44:30", "owner": "johnlewismusicc", "likes": 0}, {"id": 17879430495333517, "text": "👏come walk for us!", "created_at": "2025-11-25T00:16:37", "owner": "styxathletics", "likes": 0}, {"id": 18107926828617789, "text": "She’s so pretty hod damn", "created_at": "2025-11-24T23:42:26", "owner": "tate_blazer.insta", "likes": 0}, {"id": 18078596324275047, "text": "😍😍😍😍😍", "created_at": "2025-11-24T20:27:31", "owner": "drinkingandsports_", "likes": 0}, {"id": 18084446080843021, "text": "", "created_at": "2025-11-24T19:44:20", "owner": "knotz_dubz", "likes": 1}, {"id": 18102917017672595, "text": "finally beautiful women. no ugly obese feminists", "created_at": "2025-11-24T18:45:35", "owner": "n9_0ne", "likes": 0}, {"id": 17950107317924576, "text": "i'm going to miss you when I scroll", "created_at": "2025-11-24T18:42:13", "owner": "alexoap", "likes": 0}, {"id": 18080560325139562, "text": "", "created_at": "2025-11-24T18:29:38", "owner": "u_uihbcxxv", "likes": 0}, {"id": 18077572724179139, "text": "", "created_at": "2025-11-24T18:27:46", "owner": "lucas_drx8", "likes": 0}, {"id": 18087141094813940, "text": "", "created_at": "2025-11-24T18:27:44", "owner": "lucas_drx8", "likes": 0}, {"id": 18079465928126807, "text": "I see L A", "created_at": "2025-11-24T18:23:34", "owner": "jordan_t_fl", "likes": 0}, {"id": 18096536560873993, "text": "GOAT COMMENT👏", "created_at": "2025-11-24T18:03:48", "owner": "jodybrave", "likes": 0}, {"id": 18100475902686078, "text": "Agartha", "created_at": "2025-11-24T17:43:21", "owner": "robthagody", "likes": 0}, {"id": 17917070673210843, "text": "Oh hell yeah", "created_at": "2025-11-24T17:42:29", "owner": "maniya_edits", "likes": 0}, {"id": 18088030814315277, "text": "yes mommy", "created_at": "2025-11-24T17:39:40", "owner": "champagnemami.00", "likes": 0}, {"id": 18088909450987615, "text": "Thought it was sabrina carpenter", "created_at": "2025-11-24T17:35:51", "owner": "_frank_misael_", "likes": 0}, {"id": 18094891606872180, "text": "Me too!", "created_at": "2025-11-24T17:31:37", "owner": "sathya_vemula", "likes": 0}, {"id": 17846923086610111, "text": "", "created_at": "2025-11-24T17:23:31", "owner": "tnay__2028pt4", "likes": 0}, {"id": 17872068114462333, "text": "MOON WALKING ON THE HOES", "created_at": "2025-11-24T17:19:34", "owner": "noctyernal", "likes": 0}, {"id": 18540320449050629, "text": "", "created_at": "2025-11-24T17:19:27", "owner": "george123jorge", "likes": 0}, {"id": 18088757782750836, "text": "I’d put you on a propaganda poster to show who we’re fighting for", "created_at": "2025-11-24T17:13:43", "owner": "njsiy_", "likes": 0}, {"id": 18069732437624854, "text": "Oh she’s drop dead gorgeous", "created_at": "2025-11-24T17:12:06", "owner": "sam.marayy", "likes": 0}, {"id": 18299141617259504, "text": "", "created_at": "2025-11-24T17:10:04", "owner": "syncha01", "likes": 0}, {"id": 18080933297277740, "text": "women like this make me believe in god because no godless earth would produce such a beautiful person", "created_at": "2025-11-24T17:09:10", "owner": "gabi_on1ine", "likes": 0}, {"id": 18088497667766555, "text": "", "created_at": "2025-11-24T17:07:15", "owner": "fygj0", "likes": 0}, {"id": 18102316426661595, "text": "you like girls, bro? 😍", "created_at": "2025-11-24T17:04:54", "owner": "kara_s1205", "likes": 0}, {"id": 18087786865943061, "text": "I was wondering how’d this get on my FYP but now I know 😂", "created_at": "2025-11-24T17:00:33", "owner": "juanf422", "likes": 0}, {"id": 17958474953878686, "text": "", "created_at": "2025-11-24T16:58:57", "owner": "king_angeles65_", "likes": 0}, {"id": 18117693319484819, "text": "Hey wana hang out later?", "created_at": "2025-11-24T16:56:10", "owner": "i_like_yr_dog_", "likes": 0}, {"id": 18027807272566047, "text": "ai", "created_at": "2025-11-24T16:54:02", "owner": "jamesbunelocke", "likes": 0}, {"id": 18393216670131590, "text": "Haiii can I use these as drawing references 🥺👉👈", "created_at": "2025-11-24T16:47:57", "owner": "spooky.rei", "likes": 0}, {"id": 18110704168607553, "text": "she is pointing at me guys back off", "created_at": "2025-11-24T16:46:45", "owner": "kingdababy7", "likes": 0}, {"id": 18080745188114962, "text": "Women of culture❤️❤️ here we gather to cheer for this baddie", "created_at": "2025-11-24T16:42:47", "owner": "prxncess._k", "likes": 1}, {"id": 18063422231393720, "text": "2 UCLA posts in 3 scrolls?", "created_at": "2025-11-24T16:40:45", "owner": "_awt1sm", "likes": 0}, {"id": 17990121602884205, "text": "If Sabrina Carpenter and Dakota Johnson had a baby", "created_at": "2025-11-24T16:37:55", "owner": "brooki_wooki", "likes": 0}, {"id": 18008889329811541, "text": "", "created_at": "2025-11-24T16:35:03", "owner": "_goshark", "likes": 0}, {"id": 18112861414587210, "text": "", "created_at": "2025-11-24T16:34:29", "owner": "willduncann", "likes": 0}, {"id": 17905091868295581, "text": "Who is this 💙💛", "created_at": "2025-11-24T16:34:04", "owner": "mandomartinez5491", "likes": 0}, {"id": 18059883824249029, "text": "", "created_at": "2025-11-24T16:32:55", "owner": "sreejan_sahu__", "likes": 1}, {"id": 17969089373973578, "text": "I thought it was AI", "created_at": "2025-11-24T16:31:25", "owner": "its_swan_fr", "likes": 0}, {"id": 17856431811561856, "text": "God I should’ve gone to college", "created_at": "2025-11-24T16:31:01", "owner": "ignorantian", "likes": 0}, {"id": 18096380596874537, "text": "All of a sudden imma ucla fan 💙", "created_at": "2025-11-24T16:29:05", "owner": "1notfoolin1", "likes": 0}, {"id": 17986931894748720, "text": "@sydney_sweeney got competition.", "created_at": "2025-11-24T16:27:10", "owner": "chloeclovermansanti", "likes": 0}, {"id": 17869858551396337, "text": "", "created_at": "2025-11-24T16:17:44", "owner": "brettmykl_", "likes": 1}, {"id": 17899283601185901, "text": "", "created_at": "2025-11-24T16:15:50", "owner": "ajay.nehra.usa", "likes": 0}, {"id": 18045048827694460, "text": "Just goes to show Sydney Sweeney just an average girl", "created_at": "2025-11-24T16:14:37", "owner": "lucas.d401", "likes": 0}, {"id": 18131692300488638, "text": "🫣", "created_at": "2025-11-24T16:14:22", "owner": "za_hminga27", "likes": 0}, {"id": 18107680084619528, "text": "", "created_at": "2025-11-24T16:13:20", "owner": "ig._4d", "likes": 0}, {"id": 18048953936401811, "text": "@ronrk97 caught you bro", "created_at": "2025-11-24T16:12:56", "owner": "arlin_gurumayum", "likes": 1}, {"id": 18096958840868884, "text": "", "created_at": "2025-11-24T16:09:43", "owner": "sasaforshort", "likes": 0}, {"id": 18082425826894029, "text": "I'd have a pic of u under my helmet if I was in war", "created_at": "2025-11-24T16:08:25", "owner": "7trainstation7", "likes": 0}, {"id": 18078754463181666, "text": "She's giving so much of Lola bunny vibes.", "created_at": "2025-11-24T16:06:39", "owner": "malahim._k", "likes": 0}, {"id": 17952134271019732, "text": "", "created_at": "2025-11-24T16:06:27", "owner": "_alessio_conticini_", "likes": 0}, {"id": 17866549374427007, "text": "😍", "created_at": "2025-11-24T16:06:27", "owner": "cumloudd", "likes": 0}, {"id": 17873955471377035, "text": "Oh my god", "created_at": "2025-11-24T16:05:59", "owner": "nbriliant9", "likes": 0}, {"id": 18078218141334364, "text": "she told me to locked in, so i keep scrolling", "created_at": "2025-11-24T16:02:47", "owner": "vicopays_", "likes": 0}, {"id": 17856058287568437, "text": "", "created_at": "2025-11-24T16:01:11", "owner": "yvn.yuki", "likes": 0}, {"id": 18147618769427782, "text": "Oh good googly moogly 😭", "created_at": "2025-11-24T15:59:47", "owner": "waitisthatjesse", "likes": 1}, {"id": 18098396473699123, "text": "", "created_at": "2025-11-24T15:59:10", "owner": "fernandooochevez", "likes": 0}, {"id": 18335506555234919, "text": "And apparently this isn’t supermodel material anymore", "created_at": "2025-11-24T15:56:09", "owner": "landonghiotto", "likes": 0}, {"id": 18113791477512035, "text": "Right back at you", "created_at": "2025-11-24T15:54:35", "owner": "joshassiff", "likes": 0}, {"id": 18395637862132299, "text": "Just fell to my knees", "created_at": "2025-11-24T15:52:18", "owner": "blakezooted", "likes": 0}, {"id": 18108143965556872, "text": "", "created_at": "2025-11-24T15:48:26", "owner": "eijiputdown", "likes": 0}, {"id": 17934257283102470, "text": "", "created_at": "2025-11-24T15:47:12", "owner": "kulcsarangyalgeza1", "likes": 0}, {"id": 18134258992477945, "text": "I hope you win an all American or something 😄", "created_at": "2025-11-24T15:42:54", "owner": "c.alex713", "likes": 1}, {"id": 18050483360663775, "text": "", "created_at": "2025-11-24T15:40:53", "owner": "dee.jaybhl", "likes": 1}, {"id": 17990512661909218, "text": "", "created_at": "2025-11-24T15:40:10", "owner": "mw._9o", "likes": 0}, {"id": 18103667062591034, "text": "", "created_at": "2025-11-24T15:38:01", "owner": "c6h13o6", "likes": 0}, {"id": 17844265851617854, "text": "“Remember what ur fighting for boys”\nAs a .77mm turns me into a Christmas tree ornament-", "created_at": "2025-11-24T15:37:22", "owner": "death2cesarr", "likes": 0}, {"id": 18374797060159932, "text": "", "created_at": "2025-11-24T15:36:26", "owner": "jente_bastanie", "likes": 0}, {"id": 17948452770060120, "text": "She’s pointing at me y’all", "created_at": "2025-11-24T15:34:49", "owner": "shark_attack_fantasy", "likes": 0}, {"id": 18315370186247056, "text": "", "created_at": "2025-11-24T15:29:31", "owner": "kenrese500", "likes": 0}, {"id": 17844238674618215, "text": "gollyyyyyyyyyy", "created_at": "2025-11-24T15:27:55", "owner": "trampoline.somi", "likes": 1}, {"id": 17987245115747833, "text": "", "created_at": "2025-11-24T15:27:35", "owner": "trampoline.somi", "likes": 0}, {"id": 18070764530062994, "text": "", "created_at": "2025-11-24T15:25:13", "owner": "ashnasarahanil", "likes": 0}, {"id": 17899976952181785, "text": "", "created_at": "2025-11-24T15:22:10", "owner": "_alex.romanoo_", "likes": 1}, {"id": 18113589634572726, "text": "", "created_at": "2025-11-24T15:20:36", "owner": "iwan_rchtr", "likes": 0}, {"id": 18100030360704520, "text": "", "created_at": "2025-11-24T15:16:03", "owner": "ozi.gb", "likes": 0}, {"id": 18065687096577656, "text": "fire music choice", "created_at": "2025-11-24T15:14:03", "owner": "waqarahme01", "likes": 0}, {"id": 17857300008503010, "text": "", "created_at": "2025-11-24T15:13:05", "owner": "mireylobos", "likes": 1}, {"id": 17880976797423592, "text": "Ma’am please it’s November", "created_at": "2025-11-24T15:10:53", "owner": "acupofcoffeewithhoney", "likes": 0}, {"id": 18098458003815343, "text": "", "created_at": "2025-11-24T15:09:00", "owner": "victortrmpz", "likes": 0}, {"id": 18071284412596141, "text": "", "created_at": "2025-11-24T15:08:22", "owner": "lalmalsawm_21", "likes": 0}, {"id": 18097751869636460, "text": "YES YES", "created_at": "2025-11-24T15:07:49", "owner": "yngdmd", "likes": 0}, {"id": 18379025749149258, "text": "I don't even know what to say other than I see why them angels fell in love with human women LMFAO", "created_at": "2025-11-24T15:02:47", "owner": "theangoulmois", "likes": 0}, {"id": 17915348613090595, "text": "do you like women by chance? 🌝", "created_at": "2025-11-24T14:54:30", "owner": "k1ttyyca", "likes": 0}, {"id": 17878059942430610, "text": "just got called ugly and single in multiple languages", "created_at": "2025-11-24T14:51:37", "owner": "landonjines", "likes": 0}, {"id": 18314913472218471, "text": "", "created_at": "2025-11-24T14:51:21", "owner": "m8rzia", "likes": 0}, {"id": 17914941165236985, "text": "🔥🔥🔥", "created_at": "2025-11-24T14:50:33", "owner": "luciensant32", "likes": 0}, {"id": 18073849484192571, "text": "Built for BBC", "created_at": "2025-11-24T14:38:19", "owner": "scriptedbro", "likes": 0}, {"id": 18540448966057877, "text": "The little polaroid picture id have  in my helmet when at war", "created_at": "2025-11-24T14:37:29", "owner": "s_t__z___", "likes": 0}, {"id": 17878567719430781, "text": "Blonde blazer from Dispatch", "created_at": "2025-11-24T14:31:45", "owner": "icarley.26", "likes": 0}, {"id": 17873260974452602, "text": "", "created_at": "2025-11-24T14:30:41", "owner": "steven_kate222", "likes": 0}, {"id": 18089612480508878, "text": "", "created_at": "2025-11-24T14:30:17", "owner": "tangerine_dream_69420", "likes": 0}, {"id": 18081458756117118, "text": "ㅅㅣㅣㅣㅂㅏㅏㄹㄹ💦🥵", "created_at": "2025-11-24T14:28:21", "owner": "titae01", "likes": 0}, {"id": 18552567883048064, "text": "", "created_at": "2025-11-24T14:26:50", "owner": "anshjordan", "likes": 0}, {"id": 17987130266911654, "text": "", "created_at": "2025-11-24T14:24:45", "owner": "sire.acdt", "likes": 0}, {"id": 17946086175065664, "text": "None of these men deserve this in ANY lifetime😭", "created_at": "2025-11-24T14:20:13", "owner": "magjustvibes", "likes": 0}, {"id": 18074752832240112, "text": "", "created_at": "2025-11-24T14:19:42", "owner": "__dishant09_", "likes": 0}, {"id": 18194714776328732, "text": "", "created_at": "2025-11-24T14:17:39", "owner": "eugalek", "likes": 0}, {"id": 18065329370437553, "text": "Telln my kids this margot robbie fine ahh🥲😩", "created_at": "2025-11-24T14:16:54", "owner": "balenci", "likes": 0}, {"id": 18083816179843917, "text": "💙 my heart", "created_at": "2025-11-24T14:16:28", "owner": "9866.tomas", "likes": 0}, {"id": 18079948490137530, "text": "I'll miss you when I scroll", "created_at": "2025-11-24T14:15:01", "owner": "iamrachorilla", "likes": 0}, {"id": 18105661192712365, "text": "Epitome of beauty", "created_at": "2025-11-24T14:14:56", "owner": "premg_gk", "likes": 0}, {"id": 18383919652176230, "text": "", "created_at": "2025-11-24T14:14:28", "owner": "edwarddunhill", "likes": 0}, {"id": 18386741422179287, "text": "I like how I could be doomscrolling and this app will just show me god's finest woman", "created_at": "2025-11-24T14:12:28", "owner": "moesouilah", "likes": 0}, {"id": 18073548620518089, "text": "", "created_at": "2025-11-24T14:10:33", "owner": "shaushau93", "likes": 0}, {"id": 18489240583074214, "text": "", "created_at": "2025-11-24T14:08:58", "owner": "weeatricefordinner", "likes": 0}, {"id": 18062733026556685, "text": "", "created_at": "2025-11-24T13:58:14", "owner": "backflip_24", "likes": 0}, {"id": 18087704207486670, "text": "Im gonna miss you when i scroll", "created_at": "2025-11-24T13:54:45", "owner": "mdrndog", "likes": 0}, {"id": 18432559531104605, "text": "", "created_at": "2025-11-24T13:46:50", "owner": "thatguy.440", "likes": 0}, {"id": 18073406267350074, "text": "😍", "created_at": "2025-11-24T13:46:11", "owner": "softgaladriel", "likes": 0}, {"id": 17867717955417429, "text": "Nice smile", "created_at": "2025-11-24T12:59:22", "owner": "eagleeye848", "likes": 0}, {"id": 18035686553664189, "text": "Dang", "created_at": "2025-11-24T11:23:07", "owner": "kragen1993", "likes": 0}, {"id": 18347942323204540, "text": "❤️❤️🔥🔥😍😍🔥🔥❤️❤️🔥🔥😍😍", "created_at": "2025-11-24T07:32:45", "owner": "wilfreddelongjr", "likes": 0}, {"id": 17925706947173196, "text": "sydney who??", "created_at": "2025-11-24T03:48:37", "owner": "parkmarkert", "likes": 0}, {"id": 17975176901954545, "text": "", "created_at": "2025-11-24T02:42:23", "owner": "kaameren", "likes": 0}, {"id": 18107714158721549, "text": "❤️❤️❤️❤️❤️", "created_at": "2025-11-23T23:01:39", "owner": "caporegime7274", "likes": 0}, {"id": 17863878639517759, "text": "💙❤️💙🔥🔥😍", "created_at": "2025-11-23T22:46:58", "owner": "badger.120600", "likes": 0}, {"id": 17948045472061456, "text": "Miamorr ❤️🥰", "created_at": "2025-11-23T22:46:51", "owner": "badger.120600", "likes": 0}, {"id": 18385176490194061, "text": "😍😍😍", "created_at": "2025-11-23T22:46:23", "owner": "badger.120600", "likes": 0}, {"id": 18079912463144638, "text": "❤️❤️❤️🔥🔥🔥🔥", "created_at": "2025-11-23T19:59:58", "owner": "dannygrim402", "likes": 0}, {"id": 17906755746268339, "text": "Stared right into my soul. Period.", "created_at": "2025-11-23T19:07:54", "owner": "dullanduncaged", "likes": 0}, {"id": 17989876802736067, "text": "I already told my family about us. See you on Thanksgiving ❤️", "created_at": "2025-11-23T16:58:00", "owner": "adriel999g", "likes": 0}, {"id": 18416489701140294, "text": "", "created_at": "2025-11-23T16:35:40", "owner": "anthonythecameraman", "likes": 0}, {"id": 18352160320164886, "text": "Why does she remind me of blond blazer from dispatch?", "created_at": "2025-11-23T16:35:12", "owner": "anthonythecameraman", "likes": 0}, {"id": 17856358824564429, "text": "", "created_at": "2025-11-23T16:16:09", "owner": "famlayjewlz", "likes": 0}, {"id": 18160803862392664, "text": "", "created_at": "2025-11-23T15:13:27", "owner": "db231", "likes": 0}, {"id": 18065551307454064, "text": "You would look great in volunteer orange🍊", "created_at": "2025-11-23T14:41:11", "owner": "princeofboone", "likes": 0}, {"id": 18175262140323415, "text": "You look like that girl from a movie whose Boyfriend is always a jerk or you have dumped the hero of the movie", "created_at": "2025-11-23T14:25:34", "owner": "56y884", "likes": 0}, {"id": 18077763722275534, "text": "😍", "created_at": "2025-11-23T13:47:58", "owner": "marinabovorena", "likes": 0}, {"id": 17873788770369999, "text": "No way this was suggested to me by instagram", "created_at": "2025-11-23T13:11:03", "owner": "lmo251", "likes": 0}, {"id": 17941555233193789, "text": "❤️❤️❤️❤️❤️❤️❤️❤️", "created_at": "2025-11-23T13:03:36", "owner": "mathiasenrrique3994", "likes": 0}, {"id": 18080900951153441, "text": "I'd carry a photo of her if I ever went to war", "created_at": "2025-11-23T12:51:59", "owner": "callsignmongol", "likes": 0}, {"id": 17915045805088647, "text": "", "created_at": "2025-11-23T11:59:08", "owner": "bro_irsz", "likes": 0}, {"id": 18095394448848044, "text": "this needs 800000 million likes", "created_at": "2025-11-23T11:21:36", "owner": "snowbunnydub2", "likes": 0}, {"id": 17995674044847290, "text": "She looks like she has good genes", "created_at": "2025-11-23T10:44:07", "owner": "moi_sesmayora", "likes": 0}, {"id": 17943841761082255, "text": "", "created_at": "2025-11-23T09:53:38", "owner": "mannydoesnothing", "likes": 0}, {"id": 18070091222607159, "text": "", "created_at": "2025-11-23T08:45:39", "owner": "elsavage_stophee", "likes": 0}, {"id": 18216402142307970, "text": "", "created_at": "2025-11-23T08:17:42", "owner": "antoniosliwa", "likes": 0}, {"id": 18050284073374772, "text": "", "created_at": "2025-11-23T08:03:53", "owner": "nohara_shinosuke27", "likes": 0}, {"id": 18314152183221514, "text": "❤️", "created_at": "2025-11-23T08:00:18", "owner": "abhiiewashere", "likes": 0}, {"id": 18103504783636987, "text": "", "created_at": "2025-11-23T07:47:22", "owner": "mihaelkeehl32", "likes": 0}, {"id": 17852415486587935, "text": "", "created_at": "2025-11-23T07:29:49", "owner": "its.haileyhere", "likes": 5}, {"id": 18071958350052371, "text": "I suddenly can’t remember anything.", "created_at": "2025-11-23T07:29:42", "owner": "dougschmieder", "likes": 0}, {"id": 18513721270068977, "text": "Im sorry?", "created_at": "2025-11-23T07:24:57", "owner": "dxdmanny_", "likes": 0}, {"id": 17990788733894188, "text": "Every year", "created_at": "2025-11-23T07:23:17", "owner": "grabthebag.la", "likes": 0}, {"id": 17949869559054817, "text": "انه؟ لا لا ست غلطانة", "created_at": "2025-11-23T07:03:09", "owner": "xpaxec", "likes": 0}, {"id": 18114081148576296, "text": "", "created_at": "2025-11-23T06:57:42", "owner": "giannamedinaaa", "likes": 2}, {"id": 18139490230462188, "text": "", "created_at": "2025-11-23T06:51:34", "owner": "brandonblant0n", "likes": 0}, {"id": 18084974233836602, "text": "", "created_at": "2025-11-23T06:44:43", "owner": "scrimduzit", "likes": 0}, {"id": 18153061537418599, "text": "", "created_at": "2025-11-23T06:42:56", "owner": "chadwick_805", "likes": 0}, {"id": 18083583971047394, "text": "I didn't know I was a track and field fan until just now 😂", "created_at": "2025-11-23T06:42:04", "owner": "killjoycola", "likes": 0}, {"id": 18083674615853991, "text": "", "created_at": "2025-11-23T06:32:43", "owner": "heemio.666", "likes": 0}, {"id": 18543159841046768, "text": "Seein this as they getting bta", "created_at": "2025-11-23T06:29:02", "owner": "dmvdvn", "likes": 0}, {"id": 18099429457695661, "text": "Blonde blazer?", "created_at": "2025-11-23T06:26:52", "owner": "pure_critisizm", "likes": 0}, {"id": 17989575413861341, "text": "", "created_at": "2025-11-23T06:24:47", "owner": "muncy_insta", "likes": 0}, {"id": 18137925685457716, "text": "", "created_at": "2025-11-23T06:21:29", "owner": "shov3toe", "likes": 0}, {"id": 18063321209529798, "text": "She's exactly those gorgeous villains in Disney that makes you like her", "created_at": "2025-11-23T06:18:20", "owner": "ryanniel023", "likes": 0}, {"id": 18063458078167461, "text": "Didn’t expect this to appear on my racist algorithm", "created_at": "2025-11-23T06:11:46", "owner": "musbarrk", "likes": 0}, {"id": 18091148317736491, "text": "Is this how vietnam vets felt seeing any woman after getting home?", "created_at": "2025-11-23T06:08:34", "owner": "shfin03", "likes": 0}, {"id": 17974569893953759, "text": "Typa of women id go to war for🇺🇸🪖", "created_at": "2025-11-23T06:01:06", "owner": "viktor._c47", "likes": 0}, {"id": 17969706191975816, "text": "daaaammmmnnnnn", "created_at": "2025-11-23T05:54:15", "owner": "funtake.0", "likes": 0}, {"id": 17940011753965732, "text": "", "created_at": "2025-11-23T05:51:44", "owner": "mrducttapeguitar", "likes": 0}, {"id": 18319741213171292, "text": "are you single?", "cr