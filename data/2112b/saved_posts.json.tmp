htags": ["memes", "darkhumour", "comedy", "funny", "humour", "edgymemes", "reels"]},
{"media_id": 3767639051206543192, "shortcode": "DRJV8FZDkdY", "permalink": "https://www.instagram.com/p/DRJV8FZDkdY/", "taken_at": "2025-11-17T05:34:37", "caption": "let’s coffee chat :) \n.\n.\n.\n.\n#college #businessmajor #internships", "owner_username": "sarah_._fan", "owner_id": "4108562544", "likes": 5163, "is_video": true, "typename": "GraphVideo", "media": [{"type": "video", "path": "0009_DRJV8FZDkdY\\DRJV8FZDkdY_20251117_053437.mp4"}], "comments": [{"id": 17884490952286006, "text": "I don’t see the problem?", "created_at": "2025-11-21T01:30:30", "owner": "youraveragefinancebro", "likes": 20}, {"id": 18101404495674074, "text": "i don’t date. i strategically allocate my time to maximize shareholder value", "created_at": "2025-11-19T19:37:40", "owner": "jonny.shmeng", "likes": 138}, {"id": 18318557743172161, "text": "Can you do coffee chat please 😍", "created_at": "2025-11-19T19:45:50", "owner": "earthtravellerz", "likes": 2}, {"id": 17914130592235164, "text": "you and i together can achieve multiple synergies that will add serious value to our accounts", "created_at": "2025-11-17T06:14:21", "owner": "christineewuuu_", "likes": 92}, {"id": 18141281887450706, "text": "can i have ur linkedin?", "created_at": "2025-11-17T06:14:35", "owner": "christineewuuu_", "likes": 27}, {"id": 18054733208326816, "text": "😂😂😂", "created_at": "2025-11-22T19:08:44", "owner": "1trueflipper", "likes": 0}, {"id": 18061167692631508, "text": "are u buai cus i wanna buy u an iced coffee :)", "created_at": "2025-11-19T22:19:30", "owner": "anujtalks12", "likes": 5}, {"id": 18134067076465275, "text": "Ok i want your LinkedIn now", "created_at": "2025-11-19T09:21:46", "owner": "ibrahim__mngmnt", "likes": 1}, {"id": 17958288881882117, "text": "😂😂😂", "created_at": "2025-11-23T14:26:52", "owner": "youngstunner.algos", "likes": 0}, {"id": 18103631158574614, "text": "Ok but that J.P. Morgan line actually goes hard I won’t lie hahahaha 🗣️🔥🔥🔥", "created_at": "2025-11-17T06:01:06", "owner": "dj_yahn", "likes": 50}, {"id": 18089547583933196, "text": "POSH?", "created_at": "2025-11-26T03:07:27", "owner": "that_caffeinated_guy", "likes": 0}, {"id": 18118714924557941, "text": "Always LinkedIn ❤️🙌", "created_at": "2025-11-20T16:06:18", "owner": "saxipatellll", "likes": 0}, {"id": 17934301647105093, "text": "investment bankers have the best thing a relationship needs. investment", "created_at": "2025-11-20T05:25:39", "owner": "teriyakiiiiiiiiiii", "likes": 3}, {"id": 18008846012816643, "text": "“Can I have your LinkedIn” is NOT an effective way to flirt. May or may not have personal experience", "created_at": "2025-11-18T21:22:34", "owner": "ajp.2006", "likes": 9}, {"id": 18175632076322626, "text": "Will you be my next summer internship🥹", "created_at": "2025-11-20T07:29:41", "owner": "absurdism_101", "likes": 0}, {"id": 18426444439129026, "text": "😂😂😂😂笑死我了", "created_at": "2025-11-26T23:54:35", "owner": "loukaskge", "likes": 0}, {"id": 18115955956565743, "text": "Coffee chat rizz lol", "created_at": "2025-11-19T02:18:09", "owner": "zoey_an__", "likes": 2}, {"id": 17873278317450965, "text": "@jhsc1213817 🥲🥲🥲", "created_at": "2025-11-19T03:30:42", "owner": "jessicalin728", "likes": 0}, {"id": 18045790982456841, "text": "Gold", "created_at": "2025-11-19T18:52:36", "owner": "derekxx_xx", "likes": 0}, {"id": 18087381848068245, "text": "linkedin 😏😏", "created_at": "2025-11-19T04:20:42", "owner": "jjuullliiaallii", "likes": 1}, {"id": 18091753025310297, "text": "“cus I wanna Chase you”", "created_at": "2025-11-20T11:39:50", "owner": "jasotelixir", "likes": 0}], "location": null, "hashtags": ["college", "businessmajor", "internships"]},
{"media_id": 3766897629398757942, "shortcode": "DRGtW-hkvI2", "permalink": "https://www.instagram.com/p/DRGtW-hkvI2/", "taken_at": "2025-11-16T05:00:00", "caption": "也不能說你錯啦", "owner_username": "wangnew8", "owner_id": "47491598234", "likes": 127362, "is_video": true, "typename": "GraphVideo", "media": [{"type": "video", "path": "0010_DRGtW-hkvI2\\DRGtW-hkvI2_20251116_050000.mp4"}], "comments": [{"id": 17851769109588836, "text": "孩子試圖安慰他媽媽了😌", "created_at": "2025-11-18T03:15:08", "owner": "laian_84715", "likes": 865}, {"id": 18004833989660182, "text": "媽媽一說長皺紋・我馬上猜到 她兒子會講蛋蛋。..", "created_at": "2025-11-16T05:05:45", "owner": "yunmiao7", "likes": 6884}, {"id": 17857877661496419, "text": "我跟水瓶女兒說「媽媽啊，已經很老了」她一臉天真問「妳很老了喔？妳是不是要死了」然後開始哭😂我沒有那麼老….", "created_at": "2025-11-17T07:24:49", "owner": "erinliao.1111", "likes": 99}, {"id": 18548051902045354, "text": "Q.試闡述，當自己的臉蛋被比作別人的寶貝袋時的想法", "created_at": "2025-11-16T08:20:44", "owner": "paulshih12", "likes": 3081}, {"id": 17987467307912916, "text": "有的時候真的可以學小朋友😂已讀亂回是破解女生問陷阱題的唯一解法", "created_at": "2025-11-17T08:02:45", "owner": "ej6661000", "likes": 522}, {"id": 17886532278392642, "text": "我真是沒有猜到這結局😆", "created_at": "2025-11-16T07:53:30", "owner": "jim_0925", "likes": 2364}, {"id": 18145885816431294, "text": "有被安慰到😂", "created_at": "2025-11-16T06:45:41", "owner": "yizhenluharu", "likes": 503}, {"id": 18118255753552582, "text": "長達8秒的沈默\n😮‍💨", "created_at": "2025-11-16T09:10:19", "owner": "aroun1922", "likes": 1653}, {"id": 18085820647960453, "text": "是這樣但不是這樣😂", "created_at": "2025-11-17T08:58:39", "owner": "j40773", "likes": 36}, {"id": 18083728679025621, "text": "好貼心的孩子呀🤣👏", "created_at": "2025-11-24T17:17:11", "owner": "charlotte__hsu", "likes": 3}, {"id": 18080224117891283, "text": "我聽成雨衣（raincoat）", "created_at": "2025-11-16T06:19:02", "owner": "testudines.tortoise.turtle", "likes": 142}, {"id": 18196732207323947, "text": "好大的翻轉喔🤣🤣🤣", "created_at": "2025-11-17T18:25:48", "owner": "sammi14951", "likes": 6}, {"id": 18084602372065630, "text": "我以為會有什麼很溫馨的結局，看來我還是太小看網路了", "created_at": "2025-11-17T09:56:46", "owner": "a10040829", "likes": 66}, {"id": 18062038844541995, "text": "孩：你的臉～就像我的寶貝（袋）", "created_at": "2025-11-17T16:24:49", "owner": "ninawayliu", "likes": 16}, {"id": 18107592391623865, "text": "臉蛋也算蛋", "created_at": "2025-11-16T23:00:21", "owner": "burton_leung", "likes": 10}, {"id": 18505179529068643, "text": "我以前背單字的時候也以為我背到同一個字", "created_at": "2025-11-17T08:28:49", "owner": "haz2.10", "likes": 16}, {"id": 18101656390675677, "text": "無法反駁", "created_at": "2025-11-16T13:35:18", "owner": "nell.q.1028", "likes": 59}, {"id": 17853191736577541, "text": "先給妳希望，再給你絕望", "created_at": "2025-11-18T04:05:45", "owner": "wjy_jeff", "likes": 8}, {"id": 18411628822138475, "text": "弟弟那是皺摺😂", "created_at": "2025-11-16T15:29:58", "owner": "a727167", "likes": 7}, {"id": 18193553137330502, "text": "小孩可以這樣說，在上班的成年人很有可能被HR召去開會", "created_at": "2025-11-17T04:15:40", "owner": "chankahappy", "likes": 278}, {"id": 18104142052632468, "text": "回去爸爸得挨罵了😢", "created_at": "2025-11-16T13:00:54", "owner": "abraxas_luo", "likes": 30}, {"id": 18076168195950529, "text": "哈哈哈哈哈", "created_at": "2025-11-16T06:31:47", "owner": "kattyc622", "likes": 17}, {"id": 18404868088190670, "text": "他的蛋蛋比較老", "created_at": "2025-11-16T10:24:31", "owner": "lovemyparents3035", "likes": 430}, {"id": 18086542633806257, "text": "情緒價值給滿 😂", "created_at": "2025-11-17T23:34:30", "owner": "shitouchunyilang", "likes": 12}, {"id": 18097320124762574, "text": "😂😂😂", "created_at": "2025-11-17T14:31:13", "owner": "nightsa", "likes": 0}, {"id": 17850621660590466, "text": "#歷經滄桑", "created_at": "2025-11-16T05:53:01", "owner": "max4884", "likes": 8}, {"id": 17857633638555189, "text": "Yes... 所以eye balls旁有皺摺也是很合理的", "created_at": "2025-11-17T11:21:48", "owner": "hondo_chen", "likes": 4}, {"id": 18075243209015141, "text": "蛋蛋也有皺紋\n我兒也講過😂😂😂", "created_at": "2025-12-03T09:16:39", "owner": "zovimou", "likes": 2}, {"id": 18020102984608683, "text": "情商挺高的！", "created_at": "2025-11-16T12:57:47", "owner": "hsiao3100", "likes": 24}, {"id": 18081817808101155, "text": "😂😂😂", "created_at": "2025-11-16T07:06:28", "owner": "rosaryyam", "likes": 23}, {"id": 17926472193160718, "text": "😂😂😂", "created_at": "2025-11-16T06:02:17", "owner": "fanfan.wong.355", "likes": 9}, {"id": 17953223957904651, "text": "😂😂😂😂", "created_at": "2025-11-16T07:34:48", "owner": "manman123go", "likes": 6}, {"id": 17901631296319623, "text": "????????\n蛋蛋", "created_at": "2025-11-24T13:40:19", "owner": "x.i_ye", "likes": 1}, {"id": 18082849996844493, "text": "這孩子絕對常跟他老爸洗澡", "created_at": "2025-11-17T17:11:19", "owner": "4hyhci", "likes": 4}, {"id": 18076036730236807, "text": "等等，他說得有道理", "created_at": "2025-11-17T11:52:47", "owner": "nico_ekuro", "likes": 1}, {"id": 17989149539903540, "text": "", "created_at": "2025-11-16T22:17:50", "owner": "fuuzu527381", "likes": 19}, {"id": 17956794384010899, "text": "😂😂😂😂", "created_at": "2025-11-16T07:46:21", "owner": "gwanyu7", "likes": 2}, {"id": 17903324298294371, "text": "😂😂😂😂😂😂😂😂😂", "created_at": "2025-11-16T15:19:20", "owner": "fiona_lin0528", "likes": 1}, {"id": 18095036479867183, "text": "No, when you getting old with  your balls droop, there’s no longer any wrinkles😂", "created_at": "2025-11-17T10:37:09", "owner": "mushihk", "likes": 1}, {"id": 18421021894114367, "text": "😂😂", "created_at": "2025-11-16T06:20:49", "owner": "bao_co_co", "likes": 12}, {"id": 18199275469318779, "text": "@chingching._.frog 捉到你偷笑", "created_at": "2025-11-17T08:13:12", "owner": "mcccc724", "likes": 1}, {"id": 18342784447204907, "text": "🤣🤣🤣🤣🤣🤣🤣🤣🤣🤣🤣🤣🤣", "created_at": "2025-11-17T20:00:33", "owner": "neff67899", "likes": 2}, {"id": 17987160077745840, "text": "孩子總是純真🥹😆😊", "created_at": "2025-11-17T05:37:25", "owner": "ciel4943", "likes": 2}, {"id": 18099177097752357, "text": "尬蛋！", "created_at": "2025-11-18T13:12:33", "owner": "yee_55666", "likes": 1}, {"id": 18108279658535929, "text": "@itsmaggielee 😂", "created_at": "2025-11-1