{"media_id": 3501757783656204978, "shortcode": "DCYviawSYqy", "permalink": "https://www.instagram.com/p/DCYviawSYqy/", "taken_at": "2024-11-15T09:14:39", "caption": "𝐆𝐀𝐌𝐄 𝐒𝐓𝐀𝐑𝐓(•̀ᴗ•́)و\n𝐉𝐮𝐬𝐭 𝐦𝐞𝐞𝐭 𝐦𝐞 𝐚𝐭 𝐭𝐡𝐞 𝐖𝐈𝐒~\n𝟏𝟕/𝟏𝟏 𝟏𝟓:𝟑𝟎 𝐂𝐡𝐚𝐦𝐩𝐟𝐢𝐠𝐡𝐭 𝐕𝐒 𝐋𝐒𝐊\n𝐒𝐞𝐞 𝐲𝐨𝐮 𝐨𝐧 𝐒𝐮𝐧𝐝𝐚𝐲 ت🩷", "owner_username": "jessica.cwc", "owner_id": "1539319279", "likes": 4023, "is_video": false, "typename": "GraphImage", "media": [{"type": "image", "path": "0279_DCYviawSYqy\\DCYviawSYqy_20241115_091439.jpg"}], "comments": [{"id": 18014454068418509, "text": "美女加油", "created_at": "2024-11-28T10:30:31", "owner": "shangxindenanhai_3", "likes": 0}, {"id": 18289135291237001, "text": "❤️❤️❤️", "created_at": "2024-11-23T08:43:48", "owner": "rnsh._.wang", "likes": 0}, {"id": 17948420492883186, "text": "美", "created_at": "2024-11-20T02:17:10", "owner": "tea_miik", "likes": 0}, {"id": 18074234965541121, "text": "Beautiful very 😍😍😍😍❤️❤️", "created_at": "2024-11-19T11:05:59", "owner": "taiwantw886", "likes": 0}, {"id": 18147374389347583, "text": "❤️", "created_at": "2024-11-15T20:58:31", "owner": "kitchiu927", "likes": 0}, {"id": 17977787324792692, "text": "❤️‍🔥❤️‍🔥🔥🔥", "created_at": "2024-11-15T16:07:15", "owner": "hazelleunggg_", "likes": 0}, {"id": 18083894587542304, "text": "MY ROOMIEIEIEIEIEIEIEIEI HOT AFFFFF🤤🤤🤤🤤😍😍😍😍🤤🤤🤤🤤", "created_at": "2024-11-15T13:09:58", "owner": "gigi_leex", "likes": 0}, {"id": 18016699907355051, "text": "禎禎望落好精靈👻", "created_at": "2024-11-15T13:05:30", "owner": "lt.ching_", "likes": 0}, {"id": 17945360432780570, "text": "🔥lfg", "created_at": "2024-11-15T10:11:48", "owner": "meredithsyy_", "likes": 0}, {"id": 17922116397003021, "text": "保護你💜", "created_at": "2024-11-15T09:35:59", "owner": "nicole_liii_", "likes": 0}, {"id": 17884548663119958, "text": "Lfgggggg ❤️‍🔥❤️‍🔥❤️‍🔥", "created_at": "2024-11-15T09:21:46", "owner": "jueywong_", "likes": 0}, {"id": 18470920975005331, "text": "🔥🔥🙂‍↕️", "created_at": "2024-11-15T09:18:07", "owner": "siuki_lwk", "likes": 1}], "location": null, "hashtags": [