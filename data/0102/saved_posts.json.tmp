kes": 2}, {"id": 17878706691169804, "text": "That's me fr, but bro doesn't let me take screenshots either >:(", "created_at": "2024-10-23T23:41:52", "owner": "deathkade_aeternus794", "likes": 0}, {"id": 17957594333717834, "text": "I can't see", "created_at": "2024-10-23T23:32:28", "owner": "czosnek2117", "likes": 0}, {"id": 18024988118590475, "text": "Phone SOS called for itself", "created_at": "2024-10-23T22:58:42", "owner": "aa337912", "likes": 0}, {"id": 18013783175345908, "text": "WOO-🚨🚨🚨🚨", "created_at": "2024-10-23T22:22:05", "owner": "mmbbcalif", "likes": 0}, {"id": 17921917319986174, "text": "Me on ft 😂🤷🏽‍♂️", "created_at": "2024-10-23T21:26:12", "owner": "_moevaughn", "likes": 0}, {"id": 17846860254310234, "text": "", "created_at": "2024-10-23T21:14:58", "owner": "sasha_kogut22", "likes": 0}, {"id": 18047508680056282, "text": "NIGGA I CANT SEE", "created_at": "2024-10-23T21:04:58", "owner": "allen.kane.12382", "likes": 0}, {"id": 18048859966815792, "text": "HAHAHAHAHAAHHAHAHAHAAHHAA", "created_at": "2024-10-23T20:33:05", "owner": "here.is.ro", "likes": 2}, {"id": 17994210401538776, "text": "The SOS wasn't for him", "created_at": "2024-10-23T19:21:48", "owner": "aidan_low3ry", "likes": 1}, {"id": 18048451864980175, "text": "Oh hell nah", "created_at": "2024-10-23T18:34:36", "owner": "_raze381_", "likes": 1}, {"id": 18044911121087877, "text": "and then there I was, staring at my own reflection in the black screen", "created_at": "2024-10-23T18:10:49", "owner": "km_freiheit", "likes": 1}, {"id": 18041056052126730, "text": "Fr", "created_at": "2024-10-23T17:49:00", "owner": "mcshaneyd", "likes": 0}, {"id": 17869914117216120, "text": "", "created_at": "2024-10-23T13:01:52", "owner": "annabi.13k_", "likes": 0}, {"id": 17898052746008753, "text": "☠️", "created_at": "2024-10-23T11:15:34", "owner": "yamzishere", "likes": 0}, {"id": 17964121508689112, "text": "C'MON LET ME HAVE SOME TOO😡😭", "created_at": "2024-10-22T22:08:33", "owner": "ns_bitem", "likes": 0}, {"id": 17885809422128633, "text": "@ ?", "created_at": "2024-10-22T17:35:10", "owner": "vinlandsaga_lover", "likes": 0}, {"id": 18040339462946607, "text": "@sibchaek @glfkgofk เสปคใคร", "created_at": "2024-10-22T15:37:47", "owner": "punwasu.1", "likes": 1}, {"id": 17892783885071377, "text": "hold on brow", "created_at": "2024-10-22T10:17:13", "owner": "iamryanmlna", "likes": 1}, {"id": 18279284815172520, "text": "Phone gave him a quick time event", "created_at": "2024-10-22T06:38:18", "owner": "bocchi.of.rock", "likes": 3}, {"id": 18103797229450347, "text": "Phone fr said “the feds gotta see this”", "created_at": "2024-10-22T06:28:22", "owner": "whizzdog1557", "likes": 15}, {"id": 18019566140567615, "text": "Ayo wtf", "created_at": "2024-10-22T04:18:16", "owner": "visceral_blub", "likes": 1}, {"id": 17989799111723983, "text": "@sillyguy240", "created_at": "2024-10-22T02:47:09", "owner": "walteningthefiles", "likes": 1}, {"id": 18047541034959066, "text": "These comments 😂😂😂😂😂😂😂😂", "created_at": "2024-10-22T00:47:10", "owner": "fares_jerbi", "likes": 2}, {"id": 18053274646923959, "text": "It asked me if I was interested", "created_at": "2024-10-21T23:58:44", "owner": "aykan.n.orhan", "likes": 1}, {"id": 18248366566287649, "text": "they’re reinforced toes and she still can’t put them on right!! 😂😂", "created_at": "2024-10-21T23:32:26", "owner": "mcphatticus", "likes": 1}, {"id": 18069455269616856, "text": "Nga so down bad the phone started calling for help", "created_at": "2024-10-21T21:00:50", "owner": "233nick_", "likes": 2}, {"id": 18025318433595620, "text": "bros phone was calling for help ☠️☠️☠️", "created_at": "2024-10-21T20:49:37", "owner": "om.hs69", "likes": 40}, {"id": 18026287007166615, "text": "🚨🚨🚨", "created_at": "2024-10-21T20:16:59", "owner": "faceless_rage", "likes": 1}, {"id": 17921971526884306, "text": "Videoyuda ss aldim", "created_at": "2024-10-21T19:39:57", "owner": "emirkaraalanli", "likes": 9}, {"id": 18055051174883305, "text": "THE PHONE BEGED FOR HIM TO STOP", "created_at": "2024-10-21T19:21:41", "owner": "jjudetheedudee", "likes": 1}, {"id": 18072982354593597, "text": "😂😂😂😂😂", "created_at": "2024-10-21T17:53:29", "owner": "stephenj_king", "likes": 1}, {"id": 18010991204414390, "text": "I would chose the bear", "created_at": "2024-10-21T17:40:59", "owner": "the_yconic", "likes": 1}, {"id": 17861227530204450, "text": "this should actually be illegal to watch", "created_at": "2024-10-21T17:21:13", "owner": "kobyramzi", "likes": 1}, {"id": 17923128890972475, "text": "Brick by brick", "created_at": "2024-10-21T17:18:42", "owner": "gl1zzymuncher", "likes": 1}, {"id": 18036525128189052, "text": "", "created_at": "2024-10-21T15:33:17", "owner": "r34ap3r", "likes": 2}, {"id": 18201894010294485, "text": "@andr3hh_", "created_at": "2024-10-21T15:10:55", "owner": "mattyzsz", "likes": 1}, {"id": 18024196730439490, "text": "This brick is weird bros", "created_at": "2024-10-21T14:30:01", "owner": "jiovanc", "likes": 1}, {"id": 17944318394871633, "text": "the phone knew it was gonna get encased in semen 😭", "created_at": "2024-10-21T13:34:45", "owner": "marec.__", "likes": 1}, {"id": 18024427808579640, "text": "phone started calling for help 😭", "created_at": "2024-10-21T12:06:11", "owner": "galaxydoge72", "likes": 74}, {"id": 17865155379238144, "text": "Stop gatekeeping bro", "created_at": "2024-10-21T12:02:26", "owner": "ayoub__lr_22", "likes": 1}, {"id": 18023681318237664, "text": "fr", "created_at": "2024-10-21T08:58:17", "owner": "claudio_pug_2009", "likes": 1}, {"id": 17952043625849885, "text": "Phone : u need help, I’m calling that for u", "created_at": "2024-10-21T06:26:28", "owner": "dontdmme3", "likes": 7}, {"id": 18049162570943364, "text": "I couldn’t even pause it right to see the caption 😂", "created_at": "2024-10-21T05:12:17", "owner": "sethbt1110", "likes": 3}], "location": null, "hashtags": []},
{"media_id": 3480827840431562563, "shortcode": "DBOYnqJNp9D", "permalink": "https://www.instagram.com/p/DBOYnqJNp9D/", "taken_at": "2024-10-17T12:10:50", "caption": "Осуждаем/обсуждаем?", "owner_username": "sad_cherry", "owner_id": "307875432", "likes": 206571, "is_video": true, "typename": "GraphVideo", "media": [{"type": "video", "path": "0186_DBOYnqJNp9D\\DBOYnqJNp9D_20241017_121050.mp4"}], "comments": [{"id": 18050088778877046, "text": "Подписываемся на мою страничку, у меня много интересного🫶🏻", "created_at": "2024-12-13T17:53:58", "owner": "sad_cherry", "likes": 278}, {"id": 18417626845189033, "text": "Лучшее 🔥", "created_at": "2026-01-28T16:40:52", "owner": "yurtaev_111", "likes": 0}, {"id": 18089892746053114, "text": "Бренд Ольги Якубович😍😍😍", "created_at": "2026-01-23T14:10:10", "owner": "taptalina_tumusova", "likes": 0}, {"id": 17847585897618955, "text": "Очень красиво", "created_at": "2025-12-17T00:02:50", "owner": "caxap__official", "likes": 5}, {"id": 17871509739454359, "text": "Пошли на свидание в твою овуляцию", "created_at": "2025-11-10T08:28:31", "owner": "ncak551", "likes": 1}, {"id": 18115462843536171, "text": "Ссылку на платье 🔥 срочно", "created_at": "2025-10-13T21:55:17", "owner": "yana_verbetskaya", "likes": 2}, {"id": 17894124522335346, "text": "Кормилицу показала.....👏", "created_at": "2025-10-02T19:41:25", "owner": "anton_achk", "likes": 3}, {"id": 18098100199730443, "text": "👎🤮💩☠️", "created_at": "2025-09-27T18:29:35", "owner": "lovemkl62", "likes": 2}, {"id": 17972441240928064, "text": "Когда в поиске 😂", "created_at": "2025-09-13T09:34:59", "owner": "stebkatv", "likes": 2}, {"id": 18114964381508142, "text": "🔥🍑🌸🔥🫦🍑", "created_at": "2025-08-27T06:48:11", "owner": "haaancan.190707", "likes": 0}, {"id": 17907775380211446, "text": "😂😂😂😂", "created_at": "2025-08-24T05:57:17", "owner": "radmila_usmanova____", "likes": 0}, {"id": 18235829251293609, "text": "а можно артикул", "created_at": "2025-08-22T15:51:17", "owner": "mashk._._.ka", "likes": 1}, {"id": 18124565146481514, "text": "😂😂😂😂", "created_at": "2025-08-19T10:17:19", "owner": "nasiphan750", "likes": 0}, {"id": 18065735366238255, "text": "Можно ссылку 🔥", "created_at": "2025-08-19T05:17:07", "owner": "vishnevskaya_kriss", "likes": 1}, {"id": 18102263857589283, "text": "Можно ссылку 🔗?", "created_at": "2025-08-18T21:41:10", "owner": "dariamacri", "likes": 0}, {"id": 18059407319375673, "text": "Вот так, с потом 10 букетов присылают 😏😍", "created_at": "2025-08-18T20:05:41", "owner": "_rocknastal_cherti_sdes", "likes": 19}, {"id": 18087592522747233, "text": "Это платье овуляция 😂👏", "created_at": "2025-08-18T19:04:58", "owner": "irina_yudina_official", "likes": 4}, {"id": 18305597614222804, "text": "Овулировали в итоге?😂", "created_at": "2025-08-17T07:14:10", "owner": "alexcacokphoto", "likes": 7}, {"id": 18052299017442056, "text": "артикул срочно", "created_at": "2025-08-16T18:28:09", "owner": "miradeleee", "likes": 4}, {"id": 18522026467044592, "text": "Извините, а шо то как будто ссылка будет? 😹😹", "created_at": "2025-08-16T16:21:00", "owner": "sexy_klima", "likes": 2}, {"id": 17940612204044563, "text": "Ого го!🔥", "created_at": "2025-08-16T07:53:52", "owner": "irina_pavlova_suomi", "likes": 0}, {"id": 17982617861707255, "text": "🔥", "created_at": "2025-07-31T23:45:57", "owner": "denismedvedeff", "likes": 0}, {"id": 18177922546330667, "text": "🔥🔥🔥", "created_at": "2025-07-22T16:09:21", "owner": "alexey_kryukov._w", "likes": 0}, {"id": 17946788075880249, "text": "https://youtu.be/7mW7dmP0-MM?si=2Hj32xybC8TJNx3D", "created_at": "2025-07-16T19:42:02", "owner": "ishaq_331", "likes": 0}, {"id": 17889534390292413, "text": "😮😮😮😮🔥🙌", "created_at": "2025-07-16T04:15:25", "owner": "dyan.villavicencio", "likes": 0}, {"id": 17871979737392857, "text": "🔥", "created_at": "2025-07-15T06:04:46", "owner": "vaasiilyyy", "likes": 0}, {"id": 18145589500401541, "text": "😢", "created_at": "2025-07-12T11:15:01", "owner": "vaasiilyyy", "likes": 0}, {"id": 18050040068433319, "text": "Вот же эта эвакуация зараза 😄", "created_at": "2025-07-11T12:14:48", "owner": "v.litviakov", "likes": 0}, {"id": 17896350477126184, "text": "😁", "created_at": "2025-07-07T15:21:17", "owner": "errelix", "likes": 0}, {"id": 17970405683863669, "text": "А вроде бы и нет👏", "created_at": "2025-07-04T12:01:34", "owner": "seryi7844", "likes": 0}, {"id": 17889827424167219, "text": "🔥❤️‍🔥🔥😍", "created_at": "2025-07-02T05:30:35", "owner": "polikarp_lazaridi", "likes": 0}, {"id": 18056528597058526, "text": "Уф", "created_at": "2025-06-24T10:58:24", "owner": "miraclezxc17", "likes": 0}, {"id": 18313577542225556, "text": "Одобряем!", "created_at": "2025-06-21T00:29:15", "owner": "dvrkkillv", "likes": 0}, {"id": 18346028347089219, "text": "Любим❤️‍🔥🤣🤣🤣", "created_at": "2025-06-12T22:07:55", "owner": "igor.rikhter_", "likes": 0}, {"id": 17946468713865554, "text": "Наша", "created_at": "2025-06-10T16:33:34", "owner": "kruglove", "likes": 0}, {"id": 18095027026579790, "text": "Ohhh, your happy cherries 🍒 are little visible 😅", "created_at": "2025-06-08T08:22:23", "owner": "look_up__to_the_sky", "likes": 0}, {"id": 18067889705000599, "text": "Недурно", "created_at": "2025-06-08T04:33:09", "owner": "2824_aleksei", "likes": 0}, {"id": 17867413686310795, "text": "Платье, отвал башки! 🔥", "created_at": "2025-06-07T05:18:33", "owner": "viner_us", "likes": 0}, {"id": 18085038859661334, "text": "😍😍😍😍😍😍😍😍😍😍😍", "created_at": "2025-06-06T07:44:05", "owner": "egor.mants", "likes": 0}, {"id": 18117330913469869, "text": "Что за пушкааа 😮😂", "created_at": "2025-05-30T07:38:47", "owner": "miygashev", "likes": 0}, {"id": 17849307243466986, "text": "🔥🔥🔥", "created_at": "2025-05-21T08:38:44", "owner": "maksimovde", "likes": 0}, {"id": 18014838182711023, "text": "🔥🔥🔥😍", "created_at": "2025-05-18T04:03:22", "owner": "bear_dimych", "likes": 0}, {"id": 18031803068387021, "text": "🔥🔥🔥😍", "created_at": "2025-05-18T04:03:07", "owner": "bear_dimych", "likes": 0}, {"id": 17983103609820987, "text": "Огонь!", "created_at": "2025-05-17T07:31:05", "owner": "egor.mants", "likes": 0}, {"id": 18071543548929260, "text": "Возбуждаем😂", "created_at": "2025-05-15T11:01:07", "owner": "188_vipster_188", "likes": 0}, {"id": 18010008518562708, "text": "🔥", "created_at": "2025-05-09T19:20:35", "owner": "igorbayminov", "likes": 0}, {"id": 17946727982839724, "text": "Ободряем )", "created_at": "2025-04-22T02:48:29", "owner": "slavkaknyazev", "likes": 0}, {"id": 18078375019778325, "text": "😍", "created_at": "2025-04-12T23:37:07", "owner": "chezhegov", "likes": 0}, {"id": 17948640125953267, "text": "И?", "created_at": "2025-04-04T22:23:46", "owner": "r.0771", "likes": 0}, {"id": 18122621368437561, "text": "Одобряем", "created_at": "2025-03-26T10:03:24", "owner": "barumys", "likes": 0}, {"id": 18074995906706879, "text": "Вам Мерседес иск не вкатил за нарушение интеллектуальной собственности?", "created_at": "2025-03-06T16:42:10", "owner": "iskander_makhmudov", "likes": 0}, {"id": 18057644447120472, "text": "Великолепное🔥🔥🔥", "created_at": "2025-03-05T19:50:28", "owner": "ali_ska_suv", "likes": 0}, {"id": 17898508500054871, "text": "А подойдешь познакомится в ответ услышишь ( я не знакомлюсь мужчина отстаньте )", "created_at": "2025-03-05T15:10:49", "owner": "jacks_on1988", "likes": 0}, {"id": 18448781761075621, "text": "сосал?", "created_at": "2025-03-05T11:42:04", "owner": "_tenshou", "likes": 0}, {"id": 18138414985383450, "text": "С секретом «на обороте»👌😎😉", "created_at": "2025-03-04T21:34:06", "owner": "d_z_1303", "likes": 0}, {"id": 17963498519889967, "text": "😍😍😍", "created_at": "2025-03-04T21:11:15", "owner": "darinnnesss", "likes": 0}, {"id": 18006384992542141, "text": "😂😂😂😂 🔥", "created_at": "2025-03-04T18:10:13", "owner": "dopamine_0_0_", "likes": 0}, {"id": 18272598733269033, "text": "Осуждаем❌️ обсуждаем❌️ восторгаемся✅️✅️✅️", "created_at": "2025-03-04T13:52:16", "owner": "_.flvo._", "likes": 0}, {"id": 18060317794835662, "text": "", "created_at": "2025-03-04T12:58:41