 0}, {"id": 18103935832497963, "text": "That hurt from here", "created_at": "2025-03-09T20:10:05", "owner": "econndraft", "likes": 0}, {"id": 17909640632997849, "text": "THWACK! 🤣💪👊", "created_at": "2025-03-09T15:04:39", "owner": "georgeabruno", "likes": 0}, {"id": 17874008922290295, "text": "😂😂😂😂😂😂😂😂😂", "created_at": "2025-03-09T13:04:25", "owner": "motorcycle_adv_traveler", "likes": 0}, {"id": 17875030926278308, "text": "😂😂😂😂😂😂😂😂😂😂", "created_at": "2025-03-09T09:28:29", "owner": "angelrobleschavez", "likes": 0}, {"id": 18291598702243773, "text": "They didn't need that extra chair. 🪑", "created_at": "2025-03-08T18:30:22", "owner": "kermitthefrogger", "likes": 0}, {"id": 17859724737304672, "text": "😂😂😂😂😂😂😂😂😂😂😂😂😂", "created_at": "2025-03-08T17:59:56", "owner": "marcelo_soldi", "likes": 0}, {"id": 18349707982147622, "text": "😂😂😂😂😂😂", "created_at": "2025-03-08T14:42:33", "owner": "yashwanthkris", "likes": 0}, {"id": 18087332320522715, "text": "😂", "created_at": "2025-03-08T14:36:42", "owner": "sharon_comrade", "likes": 0}, {"id": 18070055968846357, "text": "Perfeito", "created_at": "2025-03-08T11:09:22", "owner": "paulodanuzio", "likes": 0}, {"id": 18074221462685536, "text": "Last ride power bomb😂", "created_at": "2025-03-08T07:45:10", "owner": "yusuf_kim_songjay", "likes": 0}, {"id": 18485355046041690, "text": "8M", "created_at": "2025-03-08T04:28:02", "owner": "jdaui", "likes": 0}, {"id": 17931065879905866, "text": "Hahaha", "created_at": "2025-03-08T03:01:16", "owner": "marif.photo.arts", "likes": 0}, {"id": 17944983488828051, "text": "Who \"invented\" gravity?!!", "created_at": "2025-03-08T02:32:41", "owner": "ahmed_elsawaf84", "likes": 0}, {"id": 18319506586163998, "text": "@anacampagnolo", "created_at": "2025-03-08T01:42:50", "owner": "atamaiborgesmonteiro", "likes": 0}, {"id": 17900977815136393, "text": "Because of men’s", "created_at": "2025-03-08T01:02:59", "owner": "talalofish", "likes": 0}, {"id": 18060939496950058, "text": "😂", "created_at": "2025-03-08T01:00:27", "owner": "deadmanxwayne", "likes": 0}, {"id": 18090527119567016, "text": "No había algún hombre que verifique que estaba bien eso? Jaja", "created_at": "2025-03-08T00:56:14", "owner": "mbhardcorecustom", "likes": 0}, {"id": 17974343822701008, "text": "😂😂😂😂😂😂", "created_at": "2025-03-08T00:44:09", "owner": "markey.1985", "likes": 0}, {"id": 18173782006319693, "text": "😮😮😮😮😮", "created_at": "2025-03-08T00:27:52", "owner": "43godiva", "likes": 0}, {"id": 18034065803285447, "text": "Que golpasoooo", "created_at": "2025-03-08T00:26:34", "owner": "antonio3joker", "likes": 0}, {"id": 18493020706031014, "text": "Επίσης έχω δει το ίδιο να συμβαίνει με άντρες 😂", "created_at": "2025-03-08T00:26:12", "owner": "_.p0l1kas._", "likes": 0}, {"id": 17888729640207903, "text": "Αν αυτό το θεωρείτε φεμινισμό, το έχετε χάσει το παιχνίδι 😂", "created_at": "2025-03-08T00:25:43", "owner": "_.p0l1kas._", "likes": 0}, {"id": 18088342243584810, "text": "Weakness and untrustworthy 😂", "created_at": "2025-03-08T00:22:20", "owner": "cowboy_up_4570", "likes": 0}, {"id": 18057552848083544, "text": "🤣🤣🤣🤣🤣🤣🤣🤣🤣🤣🤣", "created_at": "2025-03-08T00:18:53", "owner": "camaroboy913", "likes": 0}, {"id": 18128778781408505, "text": "😂😂😂😂 do It again...she still moví g😂", "created_at": "2025-03-08T00:09:10", "owner": "lalo_32bo", "likes": 0}, {"id": 18055466000117875, "text": "Will they blame men for what just happened?? 😮😂", "created_at": "2025-03-08T00:08:27", "owner": "mustafanifel", "likes": 0}, {"id": 18054176138131720, "text": "😂😂😂😂", "created_at": "2025-03-07T23:59:50", "owner": "el_hass__", "likes": 0}, {"id": 17938144355865858, "text": "They all thinking in a different location 😂😂😂😂 come back we have work to be done", "created_at": "2025-03-07T23:59:11", "owner": "marouf_palestine", "likes": 0}, {"id": 18074195581759753, "text": "😂😂😂😂arms aint that strong", "created_at": "2025-03-07T23:53:52", "owner": "edzgarciaiii22", "likes": 0}, {"id": 18346259785149548, "text": "😂😂😂😂😂😂", "created_at": "2025-03-07T23:52:22", "owner": "lee_moua1234", "likes": 0}, {"id": 17917030628964057, "text": "They were expecting the other girl to catch the person who was falling! Good exercise in trust! I got you girl!", "created_at": "2025-03-07T23:49:59", "owner": "westpointer85", "likes": 1}, {"id": 18056821952037799, "text": "😂😂😂😂😂😂😂😂😂😂", "created_at": "2025-03-07T23:39:04", "owner": "lordzmatrix", "likes": 0}, {"id": 18088264216575607, "text": "Marry @Your Own Risk👍🏼", "created_at": "2025-03-07T23:19:19", "owner": "darnishcookies", "likes": 0}, {"id": 17846935731405931, "text": "😂😂😂😂😂", "created_at": "2025-03-07T23:18:36", "owner": "padre_de4", "likes": 0}, {"id": 18316406002201421, "text": "Equality right there....If they were men catching her would be a different outcome 😂", "created_at": "2025-03-07T23:18:01", "owner": "neyo_the_missinglink", "likes": 0}, {"id": 18062154172952912, "text": "Awwww.. They failed to use critical thinking and got hurt...", "created_at": "2025-03-07T23:09:27", "owner": "mharr1986", "likes": 0}, {"id": 17913650210980488, "text": "😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂", "created_at": "2025-03-07T23:02:00", "owner": "alainpromorales", "likes": 0}, {"id": 18037285997222035, "text": "😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂😂", "created_at": "2025-03-07T23:00:21", "owner": "alva.romonza", "likes": 0}, {"id": 18074064868779690, "text": "😂😂😂😂", "created_at": "2025-03-07T22:58:03", "owner": "leasaulogg", "likes": 0}, {"id": 18049390778017887, "text": "😂😂😂😂😂😂😂😂😂😂", "created_at": "2025-03-07T22:54:22", "owner": "mone.y6311", "likes": 0}, {"id": 18055421630116790, "text": "😮", "created_at": "2025-03-07T22:53:33", "owner": "cuachis12", "likes": 0}, {"id": 17991585215789688, "text": "😂😂😂😂😂", "created_at": "2025-03-07T22:41:14", "owner": "eddie3229", "likes": 0}, {"id": 17868199689246190, "text": "😂😂😂😂😂😂", "created_at": "2025-03-07T22:36:29", "owner": "dalexc.bro.nigga", "likes": 0}, {"id": 18029539382634123, "text": "😂😂😂😂", "created_at": "2025-03-07T22:35:02", "owner": "bertrialh", "likes": 0}