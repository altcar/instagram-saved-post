:46", "owner": "zxg_filippo", "likes": 1}, {"id": 17877164658206769, "text": "3d", "created_at": "2024-11-30T08:20:13", "owner": "curtis_custom_collectables", "likes": 1}, {"id": 17899710558090840, "text": "3D", "created_at": "2024-11-30T08:07:57", "owner": "gating_tong", "likes": 1}, {"id": 18023992733302904, "text": "3d 謝謝", "created_at": "2024-11-30T07:49:36", "owner": "kevinyen08", "likes": 1}, {"id": 18014777429419846, "text": "3D 謝老師", "created_at": "2024-11-30T07:42:20", "owner": "online7201", "likes": 1}, {"id": 17883738885170089, "text": "3d", "created_at": "2024-11-30T07:40:42", "owner": "yuen_leung_8", "likes": 1}, {"id": 18122314462397198, "text": "3D", "created_at": "2024-11-30T07:21:58", "owner": "podfade", "likes": 1}, {"id": 17968790276804117, "text": "3D", "created_at": "2024-11-30T07:07:39", "owner": "xuan8787878787", "likes": 1}, {"id": 17859530355244505, "text": "3D", "created_at": "2024-11-30T05:20:48", "owner": "anotherbenjamin", "likes": 1}, {"id": 18468491893023713, "text": "3D", "created_at": "2024-11-30T05:08:28", "owner": "cupid_0729", "likes": 1}, {"id": 17891437464130263, "text": "3D 謝謝", "created_at": "2024-11-30T05:03:20", "owner": "daisy561210", "likes": 1}, {"id": 18088585300517695, "text": "3D", "created_at": "2024-11-30T04:59:35", "owner": "where_to____", "likes": 1}, {"id": 17892405408138368, "text": "3D", "created_at": "2024-11-30T04:51:23", "owner": "stevekuo", "likes": 1}, {"id": 18074567812540330, "text": "3D", "created_at": "2024-11-30T04:20:25", "owner": "reimondodes", "likes": 1}, {"id": 18097234954483903, "text": "3D", "created_at": "2024-11-30T04:17:25", "owner": "hungkit_li", "likes": 1}, {"id": 18313858342164353, "text": "3D AI 謝謝！", "created_at": "2024-11-30T04:06:14", "owner": "tongdenielowo", "likes": 1}, {"id": 17961728084752143, "text": "3D", "created_at": "2024-11-30T04:02:56", "owner": "yan_20.10_", "likes": 1}, {"id": 18286254697215904, "text": "3D", "created_at": "2024-11-30T03:48:38", "owner": "is_pep_si", "likes": 1}, {"id": 18021313610328483, "text": "ai", "created_at": "2024-11-30T03:47:16", "owner": "is_pep_si", "likes": 1}, {"id": 18062094031763539, "text": "AI", "created_at": "2024-11-30T03:14:43", "owner": "saralam_", "likes": 1}], "location": null, "hashtags": ["顯示卡", "輝達", "ai生成", "gamedev", "aiingames", "3dmodeling", "proceduralgeneration", "blender3d", "unrealengine", "unity3d", "gameai", "virtualproduction", "machinelearninggames", "3danimation", "leveldesign", "aigeneratedassets", "gamingtechnology", "realtimerendering", "aiart", "gamedevelopmenttips", "3denvironmentdesign", "generativeai"]},
{"media_id": 3512698007078322452, "shortcode": "DC_nDnzIEEU", "permalink": "https://www.instagram.com/p/DC_nDnzIEEU/", "taken_at": "2024-11-30T10:00:00", "caption": "簡而精列點補充👇🏻\n1. 材料：120g朱古力、80ml鮮忌廉、10g牛油和適量抹茶粉\n2. FYI 鮮忌廉=淡忌廉=生奶油=whipping cream\n3. 錫紙模的尺寸大約10x10cm\n4. 我用雙層錫紙摺成盒子，只因我手頭沒有合適的盒子作模具🤷🏻‍♀️\n5. 我會更建議大家用牛奶盒作模，切粒之前再將刀片浸熱水或燒熱，成品會更整齊美觀👍🏻\n6. 我將原本的可可粉改用抹茶粉，大家也可隨喜好選擇不同口味\n7. 灑粉是遮瑕的重要步驟😌\n\n#生巧克力 #生朱古力 #朱古力食譜 #meltykiss #食譜實驗室", "owner_username": "mumblenrumble", "owner_id": "58726935209", "likes": 5934, "is_video": true, "typename": "GraphVideo", "media": [{"type": "video", "path": "0320_DC_nDnzIEEU\\DC_nDnzIEEU_20241130_100000.mp4"}], "comments": [{"id": 18489546625004121, "text": "Meaty Kiss is not like this", "created_at": "2025-03-28T16:30:06", "owner": "jac_h3art", "likes": 0}, {"id": 18084863008581898, "text": "你令我諗起前男友串9我，用咗朱古力再整成朱古力有咩意義", "created_at": "2025-02-10T14:14:41", "owner": "rice_cheung", "likes": 68}, {"id": 18124839193403047, "text": "麥太？？", "created_at": "2025-01-02T11:07:30", "owner": "unkarring", "likes": 1}, {"id": 18018175967400113, "text": "在朱古力上面直接灑抹茶粉咪得囉😂", "created_at": "2024-12-23T19:50:44", "owner": "khloekwong820", "likes": 5}, {"id": 18324107887094594, "text": "係放喺雪櫃定係冰箱？", "created_at": "2024-12-18T13:20:25", "owner": "minniesakura_0615", "likes": 0}, {"id": 17851876905306918, "text": "鮮忌廉即係 think cream?", "created_at": "2024-12-16T00:21:08", "owner": "sokitkit", "likes": 3}, {"id": 18067818382734579, "text": "麥太扭花臣", "created_at": "2024-12-15T11:57:37", "owner": "abibibibibibibibigail", "likes": 8}, {"id": 18010017698674894, "text": "如果加熱把刀會唔會切得比較sharp啲？", "created_at": "2024-12-14T13:53:33", "owner": "socssutton", "likes": 0}, {"id": 18011960090465503, "text": "點解我覺得你個講解好似吳君如", "created_at": "2024-12-01T07:46:16", "owner": "unmelancholic.note", "likes": 158}, {"id": 18468176434015988, "text": "Melty kiss & Royce 😍😍😍😍", "created_at": "2024-11-30T11:34:11", "owner": "w.hohoho", "likes": 4}, {"id": 18027856157233569, "text": "將朱古力溶了再整成朱古力？？😂", "created_at": "2024-11-30T10:19:16", "owner": "mr_clementlau", "likes": 137}], "location": null, "hashtags": ["生巧克力", "生朱古力", "朱古力食譜", "meltykiss", "食譜實驗室"]},
