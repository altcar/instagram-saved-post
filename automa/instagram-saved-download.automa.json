        "data": {
          "disableBlock": false,
          "description": "Collect Saved posts and all media URLs",
          "code": "(async () => {\n// Automa-only Instagram Saved collector.\n// Runs on instagram.com with your logged-in Chrome session. It pages through\n// the current Saved REST endpoint, expands ad carousels via media-info, and\n// exposes two variables:\n//   instagramSavedPosts -> one row per post (metadata)\n//   instagramMedia      -> one row per media file (downloaded by Save assets)\nconst USERNAME = 'shalevfrfr';\nconst ENRICH_ADS = true;\nconst MAX_POSTS = 0; // 0 = no limit; use e.g. 50 for a test run\nconst sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));\nconst headers = { 'x-ig-app-id': '936619743392459', 'x-requested-with': 'XMLHttpRequest' };\n\nfunction imageUrl(node) {\n  const candidates = (node && node.image_versions2 && node.image_versions2.candidates) || [];\n  return candidates.length ? candidates[0].url : (node && node.display_url) || null;\n}\nfunction videoUrl(node) {\n  const versions = (node && node.video_versions) || [];\n  if (!versions.length) return null;\n  versions.sort((a, b) => (b.width || 0) * (b.height || 0) - (a.width || 0) * (a.height || 0));\n  return versions[0].url;\n}\nfunction slidesOf(node) {\n  return Array.isArray(node.carousel_media) && node.carousel_media.length ? node.carousel_media : [node];\n}\nfunction stamp(seconds) {\n  const d = new Date((seconds || 0) * 1000);\n  const p = (n) => String(n).padStart(2, '0');\n  return d.getUTCFullYear() + p(d.getUTCMonth() + 1) + p(d.getUTCDate()) + '_' + p(d.getUTCHours()) + p(d.getUTCMinutes()) + p(d.getUTCSeconds());\n}\n\nconst posts = [];\nconst mediaRows = [];\nconst seen = new Set();\nlet nextMaxId = null;\nlet more = true;\n\nwhile (more) {\n  const url = new URL('https://www.instagram.com/api/v1/feed/saved/posts/');\n  if (nextMaxId) url.searchParams.set('max_id', nextMaxId);\n  const response = await fetch(url, { credentials: 'include', headers });\n  if (!response.ok) throw new Error('Saved feed returned HTTP ' + response.status);\n  const payload = await response.json();\n\n  for (const entry of payload.items || []) {\n    const savedMedia = entry.media || entry;\n    const savedId = String(savedMedia.pk || savedMedia.id || '');\n    if (!savedId || seen.has(savedId)) continue;\n    seen.add(savedId);\n\n    let node = savedMedia;\n    // Ads often expose only one creative in the Saved payload. The real\n    // carousel is still available from the media-info endpoint.\n    if (ENRICH_ADS && savedMedia.product_type === 'ad') {\n      try {\n        const infoResponse = await fetch(\n          'https://www.instagram.com/api/v1/media/' + savedId + '/info/',\n          { credentials: 'include', headers }\n        );\n        if (infoResponse.ok) {\n          const info = await infoResponse.json();\n          if (info.items && info.items[0]) node = info.items[0];\n        }\n      } catch (error) {\n        console.warn('ad info failed', savedId, error);\n      }\n    }\n\n    const shortcode = node.code || savedMedia.code || savedId;\n    const owner = (node.user && node.user.username) || (savedMedia.user && savedMedia.user.username) || '';\n    const caption = (node.caption && node.caption.text) || (savedMedia.caption && savedMedia.caption.text) || '';\n    const takenAt = node.taken_at || savedMedia.taken_at || null;\n    const mediaId = String(node.pk || savedMedia.pk || savedId);\n    const postStamp = stamp(takenAt);\n    const slides = slidesOf(node);\n\n    slides.forEach((slide, index) => {\n      const url = videoUrl(slide) || imageUrl(slide);\n      if (!url) return;\n      const kind = videoUrl(slide) ? 'video' : 'image';\n      const ext = kind === 'video' ? 'mp4' : 'jpg';\n      mediaRows.push({\n        media_id: mediaId,\n        shortcode: shortcode,\n        owner: owner,\n        index: index + 1,\n        kind: kind,\n        url: url,\n        filename: 'ig_' + mediaId + '_' + (index + 1) + '.' + ext,\n        folder: owner + '_' + shortcode,\n        caption: caption,\n        taken_at: takenAt,\n        permalink: 'https://www.instagram.com/p/' + shortcode + '/'\n      });\n    });\n\n    posts.push({\n      media_id: mediaId,\n      shortcode: shortcode,\n      owner: owner,\n      caption: caption,\n      taken_at: takenAt,\n      is_video: !!videoUrl(node),\n      product_type: node.product_type || savedMedia.product_type || '',\n      media_count: slides.length,\n      permalink: 'https://www.instagram.com/p/' + shortcode + '/'\n    });\n\n    if (MAX_POSTS && posts.length >= MAX_POSTS) { more = false; break; }\n    await sleep(25);\n  }\n\n  nextMaxId = payload.next_max_id || null;\n  more = more && !!payload.more_available && !!nextMaxId;\n  await sleep(250);\n}\n\nautomaSetVariable('instagramSavedPosts', posts);\nautomaSetVariable('instagramMedia', mediaRows);\nautomaNextBlock({ posts: posts.length, files: mediaRows.length });\n})().catch((error) => {\n  console.error(error);\n  automaNextBlock({ $error: true, message: String(error && error.message ? error.message : error) });\n});",
          "everyNewTab": false,
